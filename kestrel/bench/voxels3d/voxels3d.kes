// A full 3D voxel world: chunks of 32x32x32 blocks, stacked 4 high.
// Density is 3D value noise in three octaves (8 lattice lookups each), so
// there are caves and overhangs; each chunk's mesh gets a face for every
// side of a solid block that touches air.
let SIZE = 32
let PAD = SIZE + 2       // solid flags include a one-block border
pub let LAYERS = 4           // chunks stacked vertically
let HEIGHT = LAYERS * SIZE

pure hash(x: int, y: int, z: int, seed: int) -> int {
    var h = i64(x) * 73856093 ^ i64(y) * 19349663 ^ i64(z) * 83492791 ^ i64(seed) * 1610612741
    h = h & 0x7FFFFFFF
    h = (h ^ (h >> 13)) * 0x5BD1E995 & 0x7FFFFFFF
    int(h ^ (h >> 15))
}

pure lattice(x: int, y: int, z: int, seed: int) -> float {
    float(hash(x, y, z, seed) & 0xFFFF) / 65535.0
}

pure smooth(t: float) -> float {
    t * t * (3.0 - 2.0 * t)
}

pure mix(a: float, b: float, t: float) -> float {
    a + (b - a) * t
}

// One octave: lattice values every 2^shift blocks, blended smoothly
// between the 8 corners of the cell around (x, y, z).
pure octave(x: int, y: int, z: int, shift: int, seed: int) -> float {
    let mask = (1 << shift) - 1
    let scale = float(1 << shift)
    let cx = x >> shift
    let cy = y >> shift
    let cz = z >> shift
    let fx = smooth(float(x & mask) / scale)
    let fy = smooth(float(y & mask) / scale)
    let fz = smooth(float(z & mask) / scale)
    let x00 = mix(lattice(cx, cy, cz, seed), lattice(cx + 1, cy, cz, seed), fx)
    let x10 = mix(lattice(cx, cy + 1, cz, seed), lattice(cx + 1, cy + 1, cz, seed), fx)
    let x01 = mix(lattice(cx, cy, cz + 1, seed), lattice(cx + 1, cy, cz + 1, seed), fx)
    let x11 = mix(lattice(cx, cy + 1, cz + 1, seed), lattice(cx + 1, cy + 1, cz + 1, seed), fx)
    mix(mix(x00, x10, fy), mix(x01, x11, fy), fz)
}

// Solid where above zero: noise, pulled toward air higher up.
pure density(x: int, y: int, z: int, seed: int) -> float {
    let n = octave(x, y, z, 5, seed) * 0.5 + octave(x, y, z, 4, seed + 1) * 0.3 +
        octave(x, y, z, 3, seed + 2) * 0.2
    n - 0.5 - float(y - HEIGHT / 2) / float(HEIGHT * 2)
}

// Solid flags (1 or 0) for chunk (cx, cy, cz) plus a one-block border, so
// the mesher can see the neighbouring chunks' blocks.
pure solids(cx: int, cy: int, cz: int, seed: int) -> [u8] {
    var out = array[u8](PAD * PAD * PAD)
    var i = 0
    for y from 0 to PAD {
        for z from 0 to PAD {
            for x from 0 to PAD {
                if density(cx * SIZE + x - 1, cy * SIZE + y - 1, cz * SIZE + z - 1, seed) > 0.0 {
                    out[i] = 1
                }
                i += 1
            }
        }
    }
    out
}

struct Mesh {
    vertices: list[vec3] = []
    normals: list[vec3] = []
    indices: list[int] = []

    // One square face, corners a b c d in Godot's front-face order
    // (clockwise seen from outside), as two triangles.
    pure quad(var self, n: vec3, a: vec3, b: vec3, c: vec3, d: vec3) {
        let base = self.vertices.len
        self.vertices.add(a); self.vertices.add(b); self.vertices.add(c); self.vertices.add(d)
        for k from 0 to 4 { self.normals.add(n) }
        self.indices.add(base); self.indices.add(base + 1); self.indices.add(base + 2)
        self.indices.add(base); self.indices.add(base + 2); self.indices.add(base + 3)
    }
}

// The mesh of chunk (cx, cy, cz): a face for each solid block side that
// touches air.
pub pure mesh(cx: int, cy: int, cz: int, seed: int) -> Mesh {
    let solid = solids(cx, cy, cz, seed)
    var m = Mesh()
    for y from 0 to SIZE {
        for z from 0 to SIZE {
            for x from 0 to SIZE {
                let i = ((y + 1) * PAD + z + 1) * PAD + x + 1
                if solid[i] == 1 {
                    let p = vec3(cx * SIZE + x, cy * SIZE + y, cz * SIZE + z)
                    if solid[i + 1] == 0 {
                        m.quad(vec3(1, 0, 0), p + vec3(1, 0, 0), p + vec3(1, 0, 1), p + vec3(1, 1, 1), p + vec3(1, 1, 0))
                    }
                    if solid[i - 1] == 0 {
                        m.quad(vec3(-1, 0, 0), p + vec3(0, 0, 1), p, p + vec3(0, 1, 0), p + vec3(0, 1, 1))
                    }
                    if solid[i + PAD * PAD] == 0 {
                        m.quad(vec3(0, 1, 0), p + vec3(0, 1, 0), p + vec3(1, 1, 0), p + vec3(1, 1, 1), p + vec3(0, 1, 1))
                    }
                    if solid[i - PAD * PAD] == 0 {
                        m.quad(vec3(0, -1, 0), p, p + vec3(0, 0, 1), p + vec3(1, 0, 1), p + vec3(1, 0, 0))
                    }
                    if solid[i + PAD] == 0 {
                        m.quad(vec3(0, 0, 1), p + vec3(1, 0, 1), p + vec3(0, 0, 1), p + vec3(0, 1, 1), p + vec3(1, 1, 1))
                    }
                    if solid[i - PAD] == 0 {
                        m.quad(vec3(0, 0, -1), p, p + vec3(1, 0, 0), p + vec3(1, 1, 0), p + vec3(0, 1, 0))
                    }
                }
            }
        }
    }
    m
}

// Builds chunk (cx, cy, cz) and returns its face count. The mesh lives in
// a temporary arena, freed when the block ends.
pub pure chunk_faces(cx: int, cy: int, cz: int, seed: int) -> int {
    var faces = 0
    arena {
        faces = mesh(cx, cy, cz, seed).indices.len / 6
    }
    faces
}

// For benchmarks: builds every chunk of a world `width` chunks wide and
// deep; returns the total face count.
pub bench(seed: int, width: int) -> int {
    var faces = 0
    for cx from 0 to width {
        for cy from 0 to LAYERS {
            for cz from 0 to width {
                faces += chunk_faces(cx, cy, cz, seed)
            }
        }
    }
    faces
}
