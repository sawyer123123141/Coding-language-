// One `x % y` per item: `bench(n, iters)` fills two lists with `n` random floats each from a
// seeded `Rng`, `x` in [-1000, 1000] and `y` in [0.5, 10], then sums `x % y` over them `iters`
// times. The operands change every item, so the math stays in the loop and its code is what is
// timed. Spec G3 is judged on these kernels; the loop and the add are in every time, and
// `math_none.kes` times them alone (it reads one list, this reads two).
use { Rng from random }

pub bench(n: int, iters: int) -> float {
    var sum = 0.0
    arena {
        var r = Rng(seed: 7)
        var xs = list[float]()
        var ys = list[float]()
        for i from 0 to n {
            xs.add(r.randf_range(-1000.0, 1000.0))
            ys.add(r.randf_range(0.5, 10.0))
        }
        for k from 0 to iters {
            for i, x in xs {
                sum += x % ys[i]
            }
        }
    }
    sum
}

main() {
    print(bench(1000, 10))
}
