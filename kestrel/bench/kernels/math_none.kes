// The loop of the `math_<op>.kes` kernels alone: `bench(n, iters)` fills a list with `n` random
// floats in [-10, 10] from a seeded `Rng`, then sums the inputs themselves over the list `iters`
// times. Its time per item is the loop's and the add's, which every `math_<op>.kes` time includes.
use { Rng from random }

pub bench(n: int, iters: int) -> float {
    var sum = 0.0
    arena {
        var r = Rng(seed: 7)
        var xs = list[float]()
        for i from 0 to n {
            xs.add(r.randf_range(-10.0, 10.0))
        }
        for k from 0 to iters {
            for x in xs {
                sum += x
            }
        }
    }
    sum
}

main() {
    print(bench(1000, 10))
}
