// `filter.kes` as a hand-written loop: the same list, the same evens, `add` into a new list.
pub bench(n: int, iters: int) -> float {
    var sum = 0.0
    arena {
        var xs = list[int]()
        var x = 1
        for i from 0 to n {
            x = (x * 75 + 74) % 65537
            xs.add(x)
        }
        for k from 0 to iters {
            arena {
                var ys = list[int]()
                for e in xs {
                    if e % 2 == 0 {
                        ys.add(e)
                    }
                }
                sum += float(ys.len) + float(ys[ys.len - 1])
            }
        }
    }
    sum
}

main() {
    print(bench(1000, 10))
}
