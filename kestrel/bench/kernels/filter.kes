// `xs.filter` on 1M ints, keeping the evens, with a closure literal. `bench(n, iters)` filters `n`
// ints `iters` times (each result is made in its own arena) and returns a checksum. The values
// are the ZX81 generator, so the parity is not a pattern the branch predictor can learn.
pub bench(n: int, iters: int) -> float {
    var sum = 0.0
    arena {
        var xs = list[int]()
        var x = 1
        for i from 0 to n {
            x = (x * 75 + 74) % 65537
            xs.add(x)
        }
        for k from 0 to iters {
            arena {
                let ys = xs.filter((e) { e % 2 == 0 })
                sum += float(ys.len) + float(ys[ys.len - 1])
            }
        }
    }
    sum
}

main() {
    print(bench(1000, 10))
}
