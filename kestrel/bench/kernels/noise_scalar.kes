// 2D value noise written with plain `int`s and `float`s: four `hash` calls per sample, one per
// lattice corner. The baseline for `noise_corners.kes` (one `hash4` for the four corners) and
// `noise_wide.kes` (four samples at once); all three, and Rust's `noise_scalar`/`noise_wide`
// (`src/noise4.rs`), give the same checksum. `bench(n, iters)` sums `n * iters` samples in order
// (`n` a multiple of 4).
let SEED = 1337

pure hash(x: int, y: int, seed: int) -> int {
    var h = x *% 0x27D4EB2D ^ y *% 0x165667B1 ^ seed *% 0x5BD1E995
    h = (h ^ (h >> 15)) *% 0x2C1B3C6D
    h = (h ^ (h >> 12)) *% 0x297A2D39
    h ^ (h >> 15)
}

pure lattice(h: int) -> float {
    float(h & 0xFFFF) / 65535.0
}

pure smooth(t: float) -> float {
    t * t * (3.0 - 2.0 * t)
}

pure noise(x: int, y: int) -> float {
    let cx = x >> 4
    let cy = y >> 4
    let fx = smooth(float(x & 15) / 16.0)
    let fy = smooth(float(y & 15) / 16.0)
    let a = lattice(hash(cx, cy, SEED))
    let b = lattice(hash(cx + 1, cy, SEED))
    let c = lattice(hash(cx, cy + 1, SEED))
    let d = lattice(hash(cx + 1, cy + 1, SEED))
    let top = a + (b - a) * fx
    let bottom = c + (d - c) * fx
    top + (bottom - top) * fy
}

pub bench(n: int, iters: int) -> float {
    var sum: f64 = 0.0
    for k from 0 to iters {
        for i from 0 to n {
            let x = i & 1023
            let y = (i >> 10) + k
            sum += f64(noise(x, y))
        }
    }
    float(sum)
}

main() {
    print(bench(4096, 4))
}
