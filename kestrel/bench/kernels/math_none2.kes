// The loop of the two-argument `math_<op>.kes` kernels alone (`atan2`, `pow`, `rem`): `bench(n,
// iters)` fills two lists with `n` random floats in [-10, 10] from a seeded `Rng`, then sums
// `x + ys[i]` over them `iters` times. Its time per item is the two loads, the bounds check on
// `ys[i]` and the adds, which every two-argument kernel's time includes.
use { Rng from random }

pub bench(n: int, iters: int) -> float {
    var sum = 0.0
    arena {
        var r = Rng(seed: 7)
        var xs = list[float]()
        var ys = list[float]()
        for i from 0 to n {
            xs.add(r.randf_range(-10.0, 10.0))
            ys.add(r.randf_range(-10.0, 10.0))
        }
        for k from 0 to iters {
            for i, x in xs {
                sum += x + ys[i]
            }
        }
    }
    sum
}

main() {
    print(bench(1000, 10))
}
