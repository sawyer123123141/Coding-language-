// One `acos` per item: `bench(n, iters)` fills a list with `n` random floats in [-1, 1] from a
// seeded `Rng`, then sums `acos` over the list `iters` times. The input changes every item, so `acos`
// stays in the loop and its inline code is what is timed. Spec G3 is judged on these kernels; the
// loop and the add are in every time, and `math_none.kes` times them alone.
use { Rng from random }

pub bench(n: int, iters: int) -> float {
    var sum = 0.0
    arena {
        var r = Rng(seed: 7)
        var xs = list[float]()
        for i from 0 to n {
            xs.add(r.randf_range(-1.0, 1.0))
        }
        for k from 0 to iters {
            for x in xs {
                sum += acos(x)
            }
        }
    }
    sum
}

main() {
    print(bench(1000, 10))
}
