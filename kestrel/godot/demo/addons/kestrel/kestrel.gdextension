[configuration]
entry_symbol = "gdext_rust_init"
compatibility_minimum = 4.2
reloadable = false

[libraries]
windows.debug.x86_64 = "res://addons/kestrel/bin/kestrel_godot.dll"
windows.release.x86_64 = "res://addons/kestrel/bin/kestrel_godot.dll"
linux.x86_64 = "res://addons/kestrel/bin/libkestrel_godot.so"
macos = "res://addons/kestrel/bin/libkestrel_godot.dylib"
