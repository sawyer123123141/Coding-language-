// expect-exit: 101
// expect-stderr: index 2 out of bounds for length 0 on line 13
// Built with `--release`. `p = Part(items: [])` empties `parts[k].items` after its guard.
struct Part {
    items: list[int]
}
main() {
    var parts = [Part(items: [1, 2, 3]), Part(items: [4, 5, 6])]
    var s = 0
    for k, p in parts {
        if parts[k].items.len > 2 {
            p = Part(items: [])
            s += parts[k].items[2]
        }
    }
    print(s)
}
