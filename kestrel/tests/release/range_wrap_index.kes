// expect-exit: 101
// expect-stderr: index -2147483648 out of bounds for length 3 on line 15
// Built with `--release`: `i + 1` wraps, so `j < xs.len` with `i >= 0` says nothing about `j`.
id(x: int, d: int) -> int {
    if d == 0 {
        return x
    }
    id(x, d - 1)
}
main() {
    let xs = [1, 2, 3]
    let i = id(2147483647, 1)
    let j = i + 1
    if i >= 0 and j < xs.len {
        print(xs[j])
    }
}
