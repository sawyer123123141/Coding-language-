// expect: 5
// expect-exit: 101
// expect-stderr: index 100000 out of bounds for length 3 on line 23
// Built with `--release`. `xs.len` is read before the call grows `xs`: the check passes, and says nothing about one length.
id(x: int, d: int) -> int {
    if d == 0 {
        return x
    }
    id(x, d - 1)
}
grow0(var xs: list[int]) -> int {
    xs.add(5)
    0
}
main() {
    var xs: list[int] = [1, 2, 3]
    let ys: list[int] = [7, 8, 9]
    var k = 0
    if id(1, 1) == 1 {
        print(xs[xs.len + grow0(var xs)])
        k = 100000
    }
    print(ys[k])
}
