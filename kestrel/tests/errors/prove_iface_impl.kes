interface Shape {
    @prove(no_alloc)
    area(self) -> float
}

struct Goblin: Shape {
    r: float = 1.0

    @prove(no_alloc)
    area(self) -> float {
        let parts = [self.r, self.r]
        parts[0] * parts[1]
    }
}

struct Disc: Shape {
    r: float = 2.0

    area(self) -> float { self.r * self.r }
}

struct Troll: Shape {
    r: float = 3.0

    area(self) -> float {
        let parts = [self.r]
        parts[0]
    }
}

main() {}

