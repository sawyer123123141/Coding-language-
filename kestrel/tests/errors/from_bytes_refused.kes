struct World {
    mem: Arena
    n: int
}

struct Fighter {
    hp: int
    on_hit: (int) -> int
}

interface Drawable {
    draw(self)
}

struct Scene {
    root: Drawable
}

look(b: list[u8], ints: list[int]) {
    print(from_bytes[World](b))
    print(from_bytes[Fighter](b))
    print(from_bytes[Scene](b))
    print(from_bytes[Arena](b))
    print(from_bytes[(int) -> int](b))
    print(from_bytes[int](ints))
    print(from_bytes[int]())
    print(from_bytes[int](b, b))
    print(from_bytes[int, float](b))
    print(from_bytes[Nope](b))
    print(from_bytes[int](var b))
}

main() {}

