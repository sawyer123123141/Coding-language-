interface Shape {
    area(self) -> int
}

struct Sq: Shape {
    xs: list[int]
    i: int = 0

    area(self) -> int { self.xs[self.i] }
}

pub relay(s: Shape, d: int) -> int {
    if d <= 0 {
        return s.area()
    }
    relay(s, d - 1)
}

@prove(no_checks)
pub total(s: Shape) -> int { relay(s, 1) }

pub relay_fn(f: (int) -> int, d: int) -> int {
    if d <= 0 {
        return f(d)
    }
    relay_fn(f, d - 1)
}

@prove(no_checks)
pub total_fn(f: (int) -> int) -> int { relay_fn(f, 1) }

interface Sized {
    @prove(no_alloc)
    size(self) -> int
}

struct Box: Sized {
    xs: list[int]

    size(self) -> int { self.xs.len }
}

@prove(no_checks)
pub measure(s: Sized) -> int { s.size() }

main() {}

