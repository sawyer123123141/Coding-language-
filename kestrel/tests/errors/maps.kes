struct Chunk {
    mem: Arena = Arena()
}

struct P {
    x: int
}

main() {
    var a: map[float, int] = {}
    var b: map[int, Chunk] = {}
    let c = {}
    var m: map[string, int] = {"a": 1}
    m["a"] += 1
    m[1] = 2
    m["b"] = "x"
    let n: int = m["a"]
    let k = {"a": 1, 2: 3}
    let fixed: map[string, int] = {"a": 1}
    fixed["b"] = 2
    print(m.size, m.missing(1))
    print("a" == 1, "a" < "b")
    var ps: map[int, P] = {}
    ps[1].x = 5
    m.has("a")
    let bad = map[int, int](5)
    let pair: map[int] = {}
    fixed.remove("a")
    print(m.get("a"))
    bump(var m["a"])
}

bump(var x: int?) {
    x = 5
}

