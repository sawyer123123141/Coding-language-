use draw

struct Pt {
    x: float
    y: float
    len2(self) -> float { self.x * self.x + self.y * self.y }
}

struct Holder {
    f: (int) -> int
}

struct Opt {
    x: (int)?
}

struct Button {
    on_click: ()
    on_click(self) { }
}

square(x: int) -> int { x * x }

pure cube(x: int) -> int { x * x * x }

effect(x: int) -> int {
    print(x)
    x
}

half(x: float) -> int { int(x) }

apply(f: (int) -> int) -> int {
    f(amount: 3)
}

pure pure_apply(f: (int) -> int) -> int {
    f(1)
}

main() {
    let m = min
    let r = draw.rect
    let p = Pt(1, 2)
    let l = p.len2
    let same = square == square
    let h = Holder(square)
    let same2 = h == h
    let fs = list[(int) -> int]()
    let found = fs.has(square)
    let ok: (int) -> int = cube
    let bad1: pure (int) -> int = effect
    let bad2: (int) -> int = half
    print(apply(cube))
}

removed_then_called(var fs: list[(int)]) {
    for f in fs {
        remove f
        f(1)
    }
}

maybe_removed_then_called(var fs: list[(int)], n: int) {
    for f in fs {
        if n > 1 { remove f }
        f(2)
    }
}

