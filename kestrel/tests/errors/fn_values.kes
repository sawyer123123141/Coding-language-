use draw

struct Pt {
    x: float
    y: float
    len2(self) -> float { self.x * self.x + self.y * self.y }
}

struct Holder {
    f: (int) -> int
}

struct Opt {
    x: (int)?
}

struct Button {
    on_click: ()
    on_click(self) { }
}

square(x: int) -> int { x * x }

pure cube(x: int) -> int { x * x * x }

effect(x: int) -> int {
    print(x)
    x
}

two(a: int, b: int) -> int { a + b }

apply(f: (int) -> int) -> int {
    f(amount: 3)
}

pure pure_apply(f: (int) -> int) -> int {
    f(1)
}

main() {
    let m = min
    let r = draw.rect
    let p = Pt(1, 2)
    let l = p.len2
    let same = square == square
    let h = Holder(square)
    let same2 = h == h
    let fs = list[(int) -> int]()
    let found = fs.has(square)
    let ok: (int) -> int = cube
    let bad1: pure (int) -> int = effect
    let bad2: (int) -> int = two
    print(apply(cube))
}
