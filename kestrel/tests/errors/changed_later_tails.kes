// An argument or receiver that is an `if` or `match` of places still points into those places'
// memory (only its header is kept), so a later argument may not change them, as for the place itself.
// `print`'s arguments, `+` and the parts of an interpolated string are read the same way.
interface D {
    pure plus(self, n: int) -> int
}

struct G: D {
    h: int = 7
    pure plus(self, n: int) -> int { self.h + n }
}

struct W {
    mem: Arena = Arena()
    ds: list[D] = []
}

struct V {
    mem: Arena = Arena()
    name: string = ""
}

enum Pick {
    A
    B
}

drop_first(var ws: list[W]) -> int {
    ws.remove_at(0)
    0
}

drop_v(var vs: list[V]) -> string {
    vs.remove_at(0)
    "c"
}

drop_n(var vs: list[V]) -> int {
    vs.remove_at(0)
    1
}

use2(d: D, n: int) -> int { d.plus(n) }

use_s(s: string, n: int) -> string { s }

ifaces(var ws: list[W], h: D, c: bool, p: Pick) {
    let fresh: D = G()
    print(use2(if c { ws[0].ds[0] } else { h }, drop_first(var ws)))
    print(use2(match p { A { ws[0].ds[0] } else { h } }, drop_first(var ws)))
    print(use2(if c { h } else { if c { fresh } else { ws[0].ds[0] } }, drop_first(var ws)))
    print((if c { ws[0].ds[0] } else { h }).plus(drop_first(var ws)))
    print(if c { ws[0].ds[0] } else { h }, drop_first(var ws))
    print(ws[0].ds[0], drop_first(var ws))
}

strings(var vs: list[V], h: string, c: bool) {
    let n = 2
    print(use_s(if c { vs[0].name } else { h }, drop_n(var vs)))
    print((if c { vs[0].name } else { h }).find(drop_v(var vs)))
    print(if c { vs[0].name } else { h }, drop_v(var vs))
    print(vs[0].name, drop_v(var vs))
    print((if c { vs[0].name } else { h }) + drop_v(var vs))
    print(vs[0].name + drop_v(var vs))
    print("{vs[0].name}{drop_v(var vs)}")
}

fine(var ws: list[W], var vs: list[V], h: D, c: bool, a: vec2) {
    // A value made fresh in its turn, an arm that names another variable, a value with no heap
    // memory, and a later argument that only reads are all fine.
    print(use2(if c { G() } else { h }, drop_first(var ws)))
    print(use_s(if c { "a" + "b" } else { "c" }, drop_n(var vs)))
    var b = a
    print((if c { a } else { b }).dot(bump(var b)))
    print(use2(if c { ws[0].ds[0] } else { h }, ws.len))
    print(vs[0].name + "!", vs.len)
    print(drop_v(var vs) + vs[0].name)
}

bump(var v: vec2) -> vec2 {
    v.x += 1.0
    v
}

main() { }

// A field or an item of such a value points into the same memory.
struct Bag {
    ds: list[D] = []
    s: string = ""
}

struct B {
    mem: Arena = Arena()
    bag: Bag = Bag()
}

drop_b(var bs: list[B]) -> int {
    bs.remove_at(0)
    0
}

fields(var bs: list[B], bag: Bag, c: bool) {
    print((if c { bs[0].bag } else { bag }).ds[0].plus(drop_b(var bs)))
    print(use2((if c { bs[0].bag } else { bag }).ds[0], drop_b(var bs)))
    print(use_s((if c { bs[0].bag } else { bag }).s, drop_b(var bs)))
    print(use_s((if c { bs[0].bag } else { bag }).s[0], drop_b(var bs)))
}
