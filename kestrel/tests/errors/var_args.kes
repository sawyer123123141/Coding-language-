struct Holder {
    mem: Arena = Arena()
    s: string = ""
}

swap_out(var h: Holder, v: string) {
    h = Holder()
    print(v)
}

parts() {
    var h = Holder()
    var other = Holder()
    let n = 1
    swap_out(var h, h.s)
    swap_out(var h, if n > 0 { h.s } else { "" })
    swap_out(var h, other.s)
}
