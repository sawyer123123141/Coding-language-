id(x: int, d: int) -> int { x }
let LIMIT = 100 / 3
struct P { v: int }

f(a: int, b: int, c: int, flag: bool, x: float, big: i64, xs: [int], p: P, n: int) {
    @assume(a < b or b < c)
    @assume(flag)
    @assume(x < 1.5)
    @assume(id(n, 1) < 3)
    @assume(xs[0] < 3)
    @assume(int(big) < 3)
    @assume(nope < 3)
    @assume(n < LIMIT)
    @assume(a < b and b <= c + 1 * 2 and -a < p.v and xs.len > 0 and big >= a)
    @assume(a / 2 < b)
}

main() {}

