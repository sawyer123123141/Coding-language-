interface Scorer {
    pure score(self) -> int
}

interface Promised {
    @prove(deterministic)
    score(self) -> int
}

interface Plain {
    score(self) -> int
}

@prove(deterministic)
pub a(s: Scorer) -> int { s.score() }

@prove(deterministic)
pub b(s: Promised) -> int { s.score() }

@prove(deterministic)
pub c(s: Plain) -> int { s.score() }

struct Dice: Promised {
    sides: int = 6

    score(self) -> int { randi_range(1, self.sides) }
}

main() {}

