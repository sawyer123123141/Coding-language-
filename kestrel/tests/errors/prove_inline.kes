pub pure g(x: int) -> int {
    if x > 0 {
        return x
    }
    0
}

@prove(inline)
pub f(x: int) -> int { g(x) }

@prove(inline)
pub r(n: int) -> int {
    if n <= 0 {
        return 0
    }
    r(n - 1)
}

@prove(inline)
pub c(xs: list[int]) -> list[int] {
    xs.map((e) { g(e) })
}

pub pure key(x: int) -> int { g(x) }

@prove(inline)
pub s(var xs: list[int]) {
    xs.sort_by((e) { key(e) })
}

@prove(inline)
pub mk() -> (int) -> int {
    (x: int) -> int { g(x) }
}

