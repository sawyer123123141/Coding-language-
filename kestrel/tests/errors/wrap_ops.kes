// The wrapping operators are for integers; floats and vectors keep the plain ones.
main() {
    let a = 1.5 *% 2.0
    var f = 1.0
    f +%= 2.0
    let v = vec2(1, 2) -% vec2(1, 1)
    let x = 0x1FFFFFFFF
    let y = 2654435761
    let h = ivec4(1)
    let z = h +% 1.5
    let q = h *% vec4(2)
}

// error 3: `*%` wraps integers; for floats use `*`
// error 5: `+%=` wraps integers; for floats use `+=`
// error 6: `-%` wraps integers; for floats use `-`
// error 7: `8589934591` doesn't fit in int
// error 8: `2654435761` doesn't fit in int
// error 10: `+%` can't mix ivec4 and float; convert the float with `int(...)` to wrap, or the ivec4 with `vec4(...)` and use `+`
// error 11: `*%` can't mix ivec4 and vec4; convert the vec4 with `ivec4(...)` to wrap, or the ivec4 with `vec4(...)` and use `*`
