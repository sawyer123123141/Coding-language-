interface Drawable {
    draw(self)
}

struct Dot: Drawable {
    n: int

    draw(self) { print(self.n) }
}

// A generic is judged at each copy: `save[int]` is fine, `save[Drawable]` isn't.
pure save[T](xs: list[T]) -> list[u8] {
    to_bytes(xs)
}

main() {
    let ints: list[int] = [1, 2]
    print(save(ints).len)
    let d: Drawable = Dot(n: 1)
    let shapes: list[Drawable] = [d]
    print(save(shapes).len)
}

// error 13: `to_bytes` can't take a `list[Drawable]`, which holds an interface value; save the fields that hold the game's state instead
