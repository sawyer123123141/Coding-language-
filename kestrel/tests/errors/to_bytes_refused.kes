struct World {
    mem: Arena
    n: int
}

struct Fighter {
    hp: int
    on_hit: (int) -> int
}

interface Drawable {
    draw(self)
}

struct Scene {
    root: Drawable
}

look(w: World, f: Fighter, s: Scene, mem: Arena) {
    print(to_bytes(w).len)
    print(to_bytes(f).len)
    print(to_bytes(s).len)
    print(to_bytes(mem).len)
    print(to_bytes(f.on_hit).len)
    print(to_bytes(f.hp).len)
    print(to_bytes())
    print(to_bytes(1, 2))
}

// `to_bytes` is a built-in name.
to_bytes(x: int) -> int { x }

main() {}

