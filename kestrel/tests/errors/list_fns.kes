struct Pool {
    mem: Arena = Arena()
}

show(n: int) { print(n) }

noisy(n: int) -> bool {
    print(n)
    true
}

make(var n: int) -> list[int] {
    n += 1
    var out: list[int] = []
    out.add(n)
    out
}

main() {
    var xs: list[int] = [1, 2, 3]
    var n = 0
    let pools: list[Pool] = []
    let f = (k: int) -> bool { k > 1 }
    let a = pools.filter((p) { true })
    let b = xs.map((e) { print(e) })
    let c = xs.map(show)
    let d = xs.map((e: float) { e })
    xs.any(f)
    xs.filter((e) { e > 1 })
    let g = xs.filter((e) { e })
    let h = xs.filter((e, i) { e > i })
    let j = make(var n).filter((e) { e > n })
}

pure bad(ys: list[int]) -> int {
    ys.filter((m) {
        print(m)
        true
    }).len
}

pure bad_value(ys: list[int], f: (int) -> bool) -> int {
    ys.filter(f).len
}

pure bad_name(ys: list[int]) -> int {
    ys.filter(noisy).len
}

par_value(zs: list[int], f: (int) -> bool) {
    par for z in zs {
        let w = zs.filter(f).len
    }
}

par_literal(zs: list[int]) {
    par for z in zs {
        let w = zs.any((e) {
            print(e)
            true
        })
    }
}

