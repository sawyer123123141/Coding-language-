struct Stack[T] {
    items: list[T] = []
}
main() {
    var s = Stack[string]()
    arena {
        s = Stack(items: ["x"])
    }
}
keep[T](var xs: list[T], v: T) {
    arena {
        xs.add(v)
    }
}
