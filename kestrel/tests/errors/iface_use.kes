interface Damageable {
    hit(var self, n: int)
    pure hp(self) -> int
    log(self, n: int)
}

interface Drawable {
    pure glyph(self) -> int
}

struct Goblin: Damageable {
    health: int = 10
    hit(var self, n: int) { self.health -= n }
    pure hp(self) -> int { self.health }
    log(self, n: int) { print(n) }
}

struct Slime: Damageable {
    size: int = 3
    hit(var self, n: int) { self.size -= n }
    pure hp(self) -> int { self.size }
    log(self, n: int) { print(n) }
}

struct Pool: Damageable {
    mem: Arena = Arena()
    hits: int = 0
    hit(var self, n: int) { self.hits += n }
    pure hp(self) -> int { self.hits }
    log(self, n: int) { print(n) }
}

struct Holder {
    d: Damageable
}

show(d: Damageable) { }
heal(var d: Damageable) { }
heal_opt(var o: Damageable?) { }
heal_list(var os: list[Damageable]) { }
take_list(os: list[Damageable]) { }
draw(x: Drawable) { }

swap(var d: Damageable) {
    d = Slime()
}

closure_replace() {
    let f = (var d: Damageable) { d = Slime() }
}

typed_replace() {
    let f: (var Damageable) = (var d) { d = Slime() }
}

var_conversions() {
    var g = Goblin()
    heal_opt(var g)
    heal_list(var g)
    heal(var g)
    show(g)
}

shallow() {
    var gs: list[Goblin] = [Goblin()]
    take_list(gs)
}

compare(a: Damageable, b: Damageable, h1: Holder, h2: Holder) {
    if a == b { }
    if h1 == h2 { }
}

find_in(os: list[Damageable], g: Goblin) {
    let found = os.has(g)
}

mixed() {
    let foes = [Goblin(), Slime()]
}

empty_items() {
    let items = array[Damageable](3)
}

pure impure_call(d: Damageable) -> int {
    d.log(1)
    d.hp()
}

parallel(foes: list[Damageable]) {
    par for f in foes {
        f.log(1)
    }
}

changing(d: Damageable) {
    d.hit(1)
}

owning() {
    var p = Pool()
    let d: Damageable = p
    show(Pool())
    show(p)
    heal(var p)
}

arena_store() {
    var keep: list[Damageable] = []
    arena {
        keep.add(Goblin())
    }
}

param_store(var h: Holder) {
    h.d = Goblin()
}

other_interface(d: Damageable) {
    draw(d)
}

main() { }
