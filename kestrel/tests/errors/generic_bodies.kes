interface Named {
    pure name(self) -> string
}
interface Loud {
    shout(self)
}
pure field_of[T](x: T) -> int { x.hp }
pure no_rule[T](x: T) -> int { x.hp() }
pure wrong_rule[T: Named](x: T) -> int { x.hp() }
pure plus[T](a: T, b: T) -> T { a + b }
pure same[T](a: T, b: T) -> bool { a == b }
pure less[T](a: T, b: T) -> bool { a < b }
pure keyed[K](k: K) -> int {
    let m = map[K, int]()
    m.len
}
pure sorted[T](xs: list[T]) -> list[T] {
    var ys = xs
    ys.sort()
    ys
}
pure contains[T](xs: list[T], x: T) -> bool { xs.has(x) }
pure zeros[T](n: int) -> int {
    let xs = array[T](n)
    xs.len
}
pure build[T]() -> int {
    let x = T()
    1
}
pure as_value[T]() -> int {
    let x = T
    1
}
pure as_named[T](x: T) -> string {
    let n: Named = x
    n.name()
}
pure calls_loud[T: Loud](x: T) { x.shout() }
shout_all[T: Loud](xs: list[T]) {
    par for x in xs { x.shout() }
}
pure convert[T](x: T) -> float { float(x) }
pure same_opt[T](a: T?, b: T?) -> bool { a == b }
pure same_list[T](a: list[T], b: list[T]) -> bool { a != b }
struct Held[T] {
    v: T
}
pure same_held[T](a: Held[T], b: Held[T]) -> bool { a == b }
add_to[T](var a: T, b: T) { a += b }
pure missing_rule[T: Missing](x: T) -> int { x.hp() }
main() {}
