struct World {
    mem: Arena
    n: int
}

struct Fighter {
    hp: int
    on_hit: (int) -> int
}

interface Drawable {
    draw(self)
}

struct Scene {
    root: Drawable
}

struct Level {
    worlds: list[World]
}

look(w: World, f: Fighter, s: Scene, l: Level, mem: Arena) {
    print(checksum(w))
    print(checksum(f))
    print(checksum(s))
    print(checksum(l))
    print(checksum(l.worlds))
    print(checksum(mem))
    print(checksum(f.on_hit))
    print(checksum(f.hp))
    print(checksum())
    print(checksum(1, 2))
}

// `checksum` is a built-in name.
checksum(x: int) -> int { x }

main() {}

