struct World {
    mem: Arena
    n: int
}

struct Fighter {
    hp: int
    on_hit: (int) -> int
}

struct Game {
    score: int
}

struct Replay {
    frames: int
}

look(w: World, f: Fighter, mem: Arena, g: Game, r: Replay) {
    print(first_difference(w, w))
    print(first_difference(f, f))
    print(first_difference(mem, mem))
    print(first_difference(f.on_hit, f.on_hit))
    print(first_difference(g, r))
    print(first_difference(1, "one"))
    print(first_difference(g))
    print(first_difference(g, g, g))
    print(first_difference(1.5, 2))
}

// `first_difference` is a built-in name.
first_difference(x: int) -> int { x }

main() {}

