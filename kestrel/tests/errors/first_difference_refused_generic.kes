interface Drawable {
    draw(self)
}

struct Dot: Drawable {
    n: int

    draw(self) { print(self.n) }
}

// A generic is judged at each copy: `differ[int]` is fine, `differ[Drawable]` isn't.
pure differ[T](a: list[T], b: list[T]) -> string? {
    first_difference(a, b)
}

main() {
    let ints: list[int] = [1, 2]
    print(differ(ints, ints))
    let d: Drawable = Dot(n: 1)
    let shapes: list[Drawable] = [d]
    print(differ(shapes, shapes))
}

// error 13: `first_difference` can't compare a `list[Drawable]`, which holds an interface value; compare the fields that hold the game's state instead
