struct H {
    mem: Arena = Arena()
    name: string = ""
}

struct W {
    g: int = 1
    cb: (var W) = (var w) { }

    step(var self, f: (int) -> int) { self.g = f(self.g) }
}

struct Brick {
    x: int
}

struct Bus {
    handlers: list[(var Bus)]
}

grow(var xs: list[int], f: () -> int) { xs.add(f()) }

bump(var n: int) -> int {
    n += 1
    n
}

shuffle(var bs: list[Brick], f: () -> int) { }
changes(var h: H, g: () -> string) { }
frees(var a: Arena, g: () -> string) { }
