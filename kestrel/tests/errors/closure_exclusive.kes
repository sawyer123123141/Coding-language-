later(g: () -> string, n: int) { }
consume(h: H) -> int { 1 }
two(g: () -> int, n: int) { }

main() {
    var xs: list[int] = [1]
    grow(var xs, () { xs.len })
    var world = W()
    world.step((e) { world.g })
    var n = 1
    two(() { n }, bump(var n))
    var bricks: list[Brick] = [Brick(x: 1)]
    for b in bricks {
        shuffle(var bricks, () { b.x })
    }
    var h = H()
    in h.mem {
        h.name = "a{n}"
    }
    changes(var h, () { h.name })
    frees(var h.mem, () { h.name })
    reads(h, () { h.name })
    later(() { h.name }, consume(h))
