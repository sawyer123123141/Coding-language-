struct Game {
    n: int
}

pub spawn_enemy(var g: Game) {
    if g.n < 0 {
        return
    }
    g.n = g.n ^ randi_range(1, 6)
}

@prove(deterministic)
pub step(var g: Game) {
    spawn_enemy(var g)
}

@prove(deterministic)
pub reseed(var g: Game) {
    rand_seed(1)
    g.n = 0
}

main() {}

