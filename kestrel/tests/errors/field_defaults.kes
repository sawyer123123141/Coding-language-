struct Inner {
    xs: list[int] = [1, 2, 3]
}

struct Outer {
    inner: Inner = Inner()
}

struct Node {
    kids: list[Node] = [Node()]
}

struct Tree {
    kids: [Tree] = KIDS
}

let KIDS = [Tree()]
let XS = [1, 2, 3]

struct Shared {
    xs: [int] = XS
}

main() {
    var keep = Shared()
    arena {
        keep = Shared()
    }
    print(keep.xs)
}

