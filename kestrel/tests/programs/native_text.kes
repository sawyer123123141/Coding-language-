// Text built for a native call lives in scratch memory that is freed after the call. A
// `return`, `continue` or `break` inside the text leaves through that cleanup too.
// env: KESTREL_HEADLESS=3
// expect: window.open 64 64 "t"
// expect: draw.text "fps 60" vec2(x: 0, y: 0) 10 Color(r: 1, g: 1, b: 1, a: 1)
// expect: draw.text_width "n=1" 10
// expect: draw.text_width "early 1" 10
// expect: width 15 35
// expect: draw.text "skip 1" vec2(x: 0, y: 0) 10 Color(r: 1, g: 1, b: 1, a: 1)
// expect: draw.text "stop 1" vec2(x: 0, y: 0) 10 Color(r: 1, g: 1, b: 1, a: 1)
// expect: end of frame 1
// expect: draw.text "fps 60" vec2(x: 0, y: 0) 10 Color(r: 1, g: 1, b: 1, a: 1)
// expect: draw.text_width "n=2" 10
// expect: width 15 -1
// expect: draw.text "fps 60" vec2(x: 0, y: 0) 10 Color(r: 1, g: 1, b: 1, a: 1)
// expect: draw.text_width "n=3" 10
// expect: draw.text_width "early 3" 10
// expect: width 15 35
// expect: draw.text "skip 3" vec2(x: 0, y: 0) 10 Color(r: 1, g: 1, b: 1, a: 1)
// expect: left the loop at 3
use window
use draw

early(i: int) -> int {
    let w = draw.text_width("early {if i == 2 { return -1 } else { i }}", 10)
    return int(w)
}

main() {
    window.open(64, 64, "t")
    var n = 0
    while window.frame() {
        n += 1
        draw.text("fps {window.fps()}", vec2(0, 0), 10, draw.WHITE)
        print("width", draw.text_width("n={n}", 10), early(n))
        draw.text("skip {if n == 2 { continue } else { n }}", vec2(0, 0), 10, draw.WHITE)
        draw.text("stop {if n == 3 { break } else { n }}", vec2(0, 0), 10, draw.WHITE)
        print("end of frame", n)
    }
    print("left the loop at", n)
}
