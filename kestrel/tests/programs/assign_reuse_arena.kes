// env: KESTREL_POISON=1
// env: KESTREL_ARENA_COUNT=1
// expect: State(xs: [0, 4, 8, 12], names: ["n0", "n1", "n2", "n3"], tag: "size 4")
// expect: State(xs: [0, 9, 18, 27, 36, 45, 54, 63, 72], names: ["n0", "n1", "n2", "n3", "n4", "n5", "n6", "n7", "n8"], tag: "size 9")
// expect: State(xs: [0, 2], names: ["n0", "n1"], tag: "size 2")
// expect: State(xs: [0, 3, 6], names: ["n0", "n1", "n2"], tag: "size 3")
// expect: State(xs: [0], names: ["n0"], tag: "size 1")
// expect: State(xs: [0, 5, 10, 15, 20], names: ["n0", "n1", "n2", "n3", "n4"], tag: "size 5")
// expect: State(xs: [0, 5, 10, 15, 20], names: ["n0", "n1", "n2", "n3", "n4"], tag: "size 5")
// expect: State(xs: [0, 2], names: ["n0", "n1"], tag: "size 2")
// expect: State(xs: [0, 7, 14, 21, 28, 35, 42], names: ["n0", "n1", "n2", "n3", "n4", "n5", "n6"], tag: "size 7")
// expect: State(xs: [], names: [], tag: "size 0")
// expect: State(xs: [0, 4, 8, 12], names: ["n0", "n1", "n2", "n3"], tag: "size 4")
// expect: State(xs: [0, 2], names: ["n0", "n1"], tag: "size 2")
// expect: State(xs: [0, 3, 6], names: ["n0", "n1", "n2"], tag: "size 3")
// expect: Keyed(names: ["v0", "v1", "v2", "v3"], m: {"k0": 0, "k1": 1, "k2": 2, "k3": 3}, counts: {0: 0, 1: 10, 2: 20, 3: 30})
// expect: Keyed(names: ["v0"], m: {"k0": 0}, counts: {0: 0})
// expect: Keyed(names: ["v0", "v1", "v2"], m: {"k0": 0, "k1": 1, "k2": 2}, counts: {0: 0, 1: 10, 2: 20})
// expect: Keyed(names: ["v0", "v1"], m: {"k0": 0, "k1": 1}, counts: {0: 0, 1: 10})
// expect: Keyed(names: ["v0", "v1", "v2", "v3", "v4", "v5"], m: {"k0": 0, "k1": 1, "k2": 2, "k3": 3, "k4": 4, "k5": 5}, counts: {0: 0, 1: 10, 2: 20, 3: 30, 4: 40, 5: 50})
// expect: Keyed(names: ["v0", "v1", "v2", "v3", "v4"], m: {"k0": 0, "k1": 1, "k2": 2, "k3": 3, "k4": 4}, counts: {0: 0, 1: 10, 2: 20, 3: 30, 4: 40})
// expect: Keyed(names: ["v0", "v1", "v2", "v3", "v4"], m: {"k0": 0, "k1": 1, "k2": 2, "k3": 3, "k4": 4}, counts: {0: 0, 1: 10, 2: 20, 3: 30, 4: 40}) Keyed(names: [], m: {}, counts: {})
// expect-stderr: arenas alive at exit: 0
// A source built in an arena that is freed afterwards, and a target inside an `Arena` field (lists,
// strings and maps), under poisoned freeing: a reused target holds nothing of the freed memory.
struct State {
    xs: list[int]
    names: list[string]
    tag: string
}

struct Holder {
    mem: Arena = Arena()
    snap: State
}

struct Keyed {
    names: list[string]
    m: map[string, int]
    counts: map[int, int]
}

struct Vault {
    mem: Arena = Arena()
    k: Keyed
}

keyed(n: int) -> Keyed {
    var k = Keyed(names: [], m: {}, counts: {})
    for i from 0 to n {
        k.names.add("v{i}")
        k.m["k{i}"] = i
        k.counts[i] = i * 10
    }
    k
}

state(n: int) -> State {
    var xs: list[int] = []
    var names: list[string] = []
    for i from 0 to n {
        xs.add(i * n)
        names.add("n{i}")
    }
    State(xs: xs, names: names, tag: "size {n}")
}

main() {
    // A source built in an arena, copied into an outer target; then the arena is freed.
    var target = state(6)
    for n in [4, 9, 2] {
        var src = Holder(snap: state(0))
        in src.mem {
            src.snap = state(n)
        }
        target = src.snap
        src = Holder(snap: state(1))
        arena {
            var junk: list[string] = []
            for i from 0 to 50 { junk.add("zzzzzzzzzzzzzzzz{i}") }
        }
        print(target)
    }

    // A target inside an `Arena` field, over states of growing and shrinking sizes.
    var h = Holder(snap: state(0))
    for n in [3, 1, 5, 5, 2, 7, 0, 4] {
        let s = state(n)
        in h.mem {
            h.snap = s
        }
        print(h.snap)
    }
    h = Holder(snap: state(2))
    print(h.snap)
    in h.mem {
        h.snap = state(3)
    }
    print(h.snap)

    // Maps inside an `Arena` field: the first state of each size has no room and is copied into
    // the field's arena; the smaller ones after it reuse those maps in place (string keys copied
    // into the field's arena, the plain map's entries reused). A copy made outside then outlives
    // the field's arena, which is freed (and poisoned) under it.
    var v = Vault(k: keyed(0))
    for n in [4, 1, 3, 2, 6, 5] {
        var src = keyed(n)
        in v.mem {
            v.k = src
        }
        src = Keyed(names: ["junk"], m: {"j": 0}, counts: {9: 9})
        print(v.k)
    }
    var keep = v.k
    v = Vault(k: keyed(0))
    arena {
        var junk: list[string] = []
        for i from 0 to 50 { junk.add("zzzzzzzzzzzzzzzz{i}") }
    }
    print(keep, v.k)
}
