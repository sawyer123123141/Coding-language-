// env: KESTREL_HEADLESS=1
// expect: window.open 64 64 "t"
// expect-exit: 101
// expect-stderr: draw3d.make_mesh needs one color per vertex or none: 3 vertices, 4 colors on line 15
use window
use draw
use draw3d
use { MeshData from draw3d }

main() {
    window.open(64, 64, "t")
    var data = MeshData()
    data.triangle(vec3(0, 0, 0), vec3(1, 0, 0), vec3(0, 1, 0), draw.RED)
    data.colors.add(draw.BLUE)
    let m = draw3d.make_mesh(data)
}
