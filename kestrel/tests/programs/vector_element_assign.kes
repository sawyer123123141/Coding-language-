// expect: eval 1
// expect: [vec2(x: 1, y: 2), vec2(x: 4, y: 5)]
// expect: eval 0
// expect: [vec2(x: 11, y: 2), vec2(x: 4, y: 5)]
// expect: eval 1
// expect: eval 1
// expect: [vec2(x: 11, y: 2), vec2(x: 5, y: 6)]
// expect: eval 0
// expect: [vec2(x: 11, y: 3), vec2(x: 5, y: 6)]
// Compound assignment to a vector element or one of its components writes
// the element, and its index expression runs once.
noisy(n: int) -> int {
    print("eval", n)
    n
}

main() {
    var vs = [vec2(1, 2), vec2(3, 4)]
    vs[noisy(1)] += vec2(1, 1)
    print(vs)
    vs[noisy(0)].x += 10
    print(vs)
    vs[noisy(1)] += vs[noisy(1)] * 0 + vec2(1, 1)
    print(vs)
    vs[noisy(0)].y += 1
    print(vs)
}
