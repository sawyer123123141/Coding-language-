// env: KESTREL_HEADLESS=1
// expect: window.open 64 64 "t"
// expect: draw3d.camera Camera(pos: vec3(x: 0, y: 0, z: -3), target: vec3(x: 0, y: 0, z: 0), up: vec3(x: 0, y: 1, z: 0), fov: 75)
// expect-exit: 101
// expect-stderr: draw3d.mesh got an empty mesh; make one with draw3d.make_mesh on line 16
use window
use draw
use draw3d
use { Camera, Mesh from draw3d }

main() {
    window.open(64, 64, "t")
    // A zero-filled array holds empty meshes: their id is 0, which is no GPU object.
    let blank = array[Mesh](1)
    draw3d.camera(Camera(pos: vec3(0, 0, -3), target: vec3(0, 0, 0)))
    draw3d.mesh(blank[0], vec3(0, 0, 0), draw.WHITE)
}
