// expect: 7.5 true
// expect: ab!
// expect: Pair(a: 3, b: 4)
// expect: 3 5
// expect: 9000000000
// expect: 200 [1, 2, 3, 4]
// expect: 6
// expect: 5
// expect: 7
pair(a: int, b: int) -> Pair { Pair(a, b) }
struct Pair {
    a: int
    b: int
}
half_plus(x: float, flag: bool) -> float { if flag { x / 2.0 + 5.0 } else { x } }
bang(s: string) -> string { "{s}!" }
swap(var p: Pair) {
    let t = p.a
    p.a = p.b
    p.b = t
}
big(x: i64) -> i64 { x * 3000 }
widen(x: u8) -> int { int(x) * 2 }
fill(var xs: list[int], n: int) { for i from 1 to n + 1 { xs.add(i) } }
sum(p: Pair) -> int { p.a + p.b }
apply_twice(f: (int) -> int, x: int) -> int { f(f(x)) }
inc(x: int) -> int { x + 1 }
nested(x: int) -> (int) -> int {
    inc
}
main() {
    let h = half_plus
    print(h(5.0, true), h(1.0, false) == 1.0)
    let b = bang
    print(b("ab"))
    let p = pair
    print(p(3, 4))
    let s = swap
    var q = Pair(a: 5, b: 3)
    s(var q)
    print(q.a, q.b)
    let g = big
    print(g(3000000))
    let w = widen
    var xs = list[int]()
    let f = fill
    f(var xs, 4)
    print(w(100), xs)
    let sm = sum
    print(sm(Pair(a: 1, b: 5)))
    print(apply_twice(inc, 3))
    print(nested(0)(6))
}
