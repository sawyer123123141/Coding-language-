// expect: 511
// expect: 7 orig 8 changed
// Closures that name nothing from outside themselves, then closures that capture.
struct Button {
    label: string
    on_click: (int) = (n) { print("default click", n) }
}

struct Holder {
    mem: Arena = Arena()
}

enum Kind {
    Plain
    Coin { value: int }
}

let DOUBLE = (x: int) -> int { x * 2 }
let TABLE = [(x: int) -> int { x + 1 }, (x: int) -> int { x * 2 }]

apply(f: (int) -> int, x: int) -> int { f(x) }

adder() -> (int) -> int {
    return (x) { x + 100 }
}

make() -> (int) -> int {
    arena {
        return (x) { x + 1 }
    }
}

make_nested() -> (int) -> int {
    let outer = () -> (int) -> int { (x: int) -> int { x + 1 } }
    outer()
}

main() {
    let hurt = (amount: int) { print("ouch", amount) }
    hurt(3)

    // Parameter types come from the context.
    let f: (int) -> int = (x) { x * 3 }
    print(f(4))
    print(apply((x) { x - 1 }, 5))
    var b = Button(label: "a", on_click: (n) { })
    b.on_click(1)
    b.on_click = (n) { print("n", n) }
    b.on_click(7)
    let d = Button(label: "d")
    d.on_click(2)
    print(adder()(1))

    // A `var` parameter.
    let inc: (var int) = (var p) { p += 1 }
    var v = 1
    inc(var v)
    print(v)

    // `return` leaves the closure.
    let early = (x: int) -> int {
        if x < 0 { return 0 }
        x
    }
    print(early(-5))
    print(early(5))
    print(make()(10))

    var xs: list[int] = [1, 2, 3]
    par for x in xs {
        let sq = (n: int) -> int {
            if n > 2 { return n * n }
            n
        }
        x = sq(x)
    }
    print(xs)

    // Parentheses in the head of a statement still group.
    let ready = true
    if (ready) { print("go") }
    var n = 2
    while (n > 0) { n -= 1 }
    print("n is", n)
    let k = Kind.Coin(value: 3)
    match (k) {
        Coin c { print("coin", c.value) }
        else { print("plain") }
    }
    var total = 0
    for item in (xs) { total += item }
    print(total - 6)
    var h = Holder()
    in (h.mem) { print("in the arena") }

    // A body of several lines inside a call's parentheses.
    let r = apply((x) {
        let y = x + 1
        y * 2
    }, 4)
    print(r)

    // A closure followed by `(3)` on the same line is called.
    print((x: int) -> int { x + 1 }(3))
    print(DOUBLE(4))
    print(TABLE[1](5))
    print(make_nested()(1))
    print(apply(DOUBLE, 10) + 1)

    // A capture is a path: `s.name` is copied when the closure is made, not `s`.
    var s = Named(name: "a")
    s.cb = () { s.name }
    s.name = "b"
    print(s.cb())
    var tg = Tagged(name: "first")
    tg.set()
    print(tg.cb(), tg.name)

    captures()
    copies()
    views()
    par_capture()
    function_collections()
    var hero = Hero(hp: 1, mp: 2)
    print(hero.pump())
    var n2 = 1
    var s2 = "orig"
    let said = bump_then_capture(var n2, var s2)
    print(said(), n2, s2)
}

struct Named {
    name: string
    cb: () -> string = () { "" }
}

struct Tagged {
    mem: Arena = Arena()
    name: string
    cb: () -> string = () { "" }

    set(var self) {
        in self.mem {
            self.cb = () { self.name }
        }
        self.name = "later"
    }
}

struct Shower {
    show: () -> string = () { "none" }
}

struct Boxed {
    mem: Arena = Arena()
    s: Shower = Shower()
}

struct World {
    score: int
    chunks: list[int]
}

make_adder(n: int) -> (int) -> int {
    (x) { x + n }
}

captures() {
    let k = 10
    let add_k = (x: int) { x + k }
    print(add_k(5))
    print(make_adder(2)(5))
    var n = 1
    let f = () { n }
    n = 5
    print(f())

    // Each call hands out its own copy of the captured list.
    var xs: list[int] = [1, 2, 3]
    let g = () { xs }
    var a = g()
    var b = g()
    a.add(1)
    b.add(2)
    print(a, b)

    // A closure inside a closure captures the outer one's parameter and its capture.
    let outer = (x: int) {
        let inner = (y: int) { x + y + k }
        inner(1)
    }
    print(outer(2))

    // A closure that captures a closure, and a copy of it.
    let twice = (x: int) { add_k(add_k(x)) }
    print(twice(1))
    let t2 = twice
    print(t2(0))

    arena {
        let add = (x: int) { x + k + n }
        print(add(1))
    }
}

copies() {
    var word = "hi"
    var nums: list[int] = [1, 2]
    var a = Shower(show: () { "{word} {nums}" })
    var b = a
    word = "bye"
    nums.add(3)
    print(a.show())
    print(b.show())

    // A copy taken out of an arena that is then freed keeps its own captures.
    var bx = Boxed()
    in bx.mem {
        bx.s = Shower(show: () { "{word} {nums}" })
    }
    let kept = bx.s
    bx = Boxed()
    print(kept.show())

    // The environment holds its own copy of a captured string whose arena is then freed.
    var tg = Tagged(name: "")
    in tg.mem {
        tg.name = "built {word}"
    }
    let said = () { tg.name }
    tg = Tagged(name: "")
    print(said())
}

views() {
    let names: list[string] = ["ann", "bob"]
    var fs = list[() -> string]()
    for nm in names {
        fs.add(() { nm })
    }
    for one in fs {
        print(one())
    }
    let kind = Kind.Coin(value: 3)
    match kind {
        Coin c {
            let cv = () { c.value * 2 }
            print(cv())
        }
        else { }
    }
    let maybe: string? = "opt"
    let got = maybe else { return }
    let gf = () { got }
    print(gf())
}

par_capture() {
    var w = World(score: 5, chunks: [1, 2, 3])
    par for c in w.chunks {
        let bonus = () { w.score }
        c = c + bonus()
    }
    print(w.chunks)
}

// A list, a map and a function value of function values may be captured: only a struct or enum
// holding one (like `self` with a function field) would nest copies.
function_collections() {
    let k = 10
    var hs: list[(int) -> int] = [(x) { x + k }]
    let usef = () { hs[0](1) }
    hs[0] = (x) { x }
    var ops = map[string, (int) -> int]()
    ops["inc"] = (x) { x + 1 }
    let useop = () { ops.get("inc", (x) { x })(5) }
    ops["inc"] = (x) { x }
    let h = hs[0]
    let viaf = () { h(11) }
    print(usef(), useop(), viaf())
}

struct Hero {
    hp: int
    mp: int

    // The capture is the value when the closure is made, even while `promote` keeps `self.hp`
    // in a register.
    pump(var self) -> int {
        self.hp = 5
        let f = () { self.hp }
        self.hp = 9
        run0(() { self.hp + self.mp }) + f() * 100
    }
}

run0(f: () -> int) -> int { f() }

// Captures of `var` parameters copy their values when the closure is made.
bump_then_capture(var n: int, var s: string) -> () -> string {
    n = 7
    let f = () { "{n} {s}" }
    n = 8
    s = "changed"
    f
}
