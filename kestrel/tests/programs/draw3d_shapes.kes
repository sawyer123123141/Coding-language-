// env: KESTREL_HEADLESS=2
// expect: window.open 64 48 "draw3d"
// expect: frame 1
// expect: draw.clear Color(r: 0, g: 0, b: 0, a: 1)
// expect: draw3d.camera Camera(pos: vec3(x: 0, y: 0, z: -3), target: vec3(x: 0, y: 0, z: 0), up: vec3(x: 0, y: 1, z: 0), fov: 75)
// expect: draw3d.cube vec3(x: 0, y: 0, z: 0) vec3(x: 1, y: 2, z: 3) Color(r: 1, g: 0, b: 0, a: 1)
// expect: draw3d.sphere vec3(x: 2, y: 0, z: 0) 0.5 Color(r: 0, g: 0, b: 1, a: 1)
// expect: draw3d.line vec3(x: -1, y: -1, z: 0) vec3(x: 1, y: 1, z: 0) Color(r: 1, g: 1, b: 1, a: 1)
// expect: draw.text "n 1" vec2(x: 2, y: 2) 10 Color(r: 1, g: 1, b: 1, a: 1)
// expect: draw3d.cube vec3(x: 0, y: -2, z: 0) vec3(x: 1, y: 1, z: 1) Color(r: 1, g: 1, b: 0, a: 1)
// expect: frame 2
// expect: draw.clear Color(r: 0, g: 0, b: 0, a: 1)
// expect: draw3d.cube vec3(x: 0, y: 2, z: 0) vec3(x: 1, y: 1, z: 1) Color(r: 0, g: 1, b: 0, a: 1)
// expect: draw3d.camera Camera(pos: vec3(x: 0, y: 0, z: -3), target: vec3(x: 0, y: 0, z: 0), up: vec3(x: 0, y: 1, z: 0), fov: 75)
// expect: draw3d.cube vec3(x: 0, y: 0, z: 0) vec3(x: 1, y: 2, z: 3) Color(r: 1, g: 0, b: 0, a: 1)
// expect: draw3d.sphere vec3(x: 2, y: 0, z: 0) 0.5 Color(r: 0, g: 0, b: 1, a: 1)
// expect: draw3d.line vec3(x: -1, y: -1, z: 0) vec3(x: 1, y: 1, z: 0) Color(r: 1, g: 1, b: 1, a: 1)
// expect: draw.text "n 2" vec2(x: 2, y: 2) 10 Color(r: 1, g: 1, b: 1, a: 1)
// expect: draw3d.cube vec3(x: 0, y: -2, z: 0) vec3(x: 1, y: 1, z: 1) Color(r: 1, g: 1, b: 0, a: 1)
// expect: frames 2
use window
use draw
use draw3d
use { Camera from draw3d }

main() {
    window.open(64, 48, "draw3d")
    let cam = Camera(pos: vec3(0, 0, -3), target: vec3(0, 0, 0))
    var n = 0
    while window.frame() {
        n += 1
        print("frame", n)
        draw.clear(draw.BLACK)
        if n == 2 {
            // The camera from the first frame is still set, so this draws in 3D without a call to camera.
            draw3d.cube(vec3(0, 2, 0), vec3(1, 1, 1), draw.GREEN)
        }
        draw3d.camera(cam)
        draw3d.cube(vec3(0, 0, 0), vec3(1, 2, 3), draw.RED)
        draw3d.sphere(vec3(2, 0, 0), 0.5, draw.BLUE)
        draw3d.line(vec3(-1, -1, 0), vec3(1, 1, 0), draw.WHITE)
        // A draw call goes back to 2D, and the next draw3d call is in 3D again with the same camera.
        draw.text("n {n}", vec2(2, 2), 10, draw.WHITE)
        draw3d.cube(vec3(0, -2, 0), vec3(1, 1, 1), draw.YELLOW)
    }
    print("frames", n)
}
