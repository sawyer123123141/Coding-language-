// expect: Enemy.Zombie(hp: 7, speed: 1.5)
// expect: Enemy.Ghost 0
// expect: 14
enum Enemy {
    Zombie { hp: int, speed: float }
    Skeleton { hp: int, arrows: int }
    Ghost

    take_damage(var self, dmg: int) {
        match self {
            Zombie z { z.hp -= dmg }
            Skeleton s { s.hp -= dmg * 2 }
            Ghost { }
        }
    }

    pure hp(self) -> int {
        match self {
            Zombie z { z.hp }
            Skeleton s { s.hp }
            else { 0 }
        }
    }
}

main() {
    var z = Enemy.Zombie(hp: 10, speed: 1.5)
    z.take_damage(3)
    print(z)
    let g = Enemy.Ghost
    print(g, g.hp())
    var s = Enemy.Skeleton(hp: 20, arrows: 2)
    s.take_damage(3)
    print(s.hp())
}
