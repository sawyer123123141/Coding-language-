// expect: 3 7
// expect: 2 [7, 0]
// expect: first first 1
// expect: none
// `let ... else` reads an optional parameter or field in place, even when it owns an arena.
struct Pool {
    mem: Arena = Arena()
    items: list[int] = []
}

struct Level {
    pool: Pool?

    size(self) -> int {
        let p = self.pool else {
            return 0
        }
        p.items.len
    }
}

total(o: Pool?) -> int {
    let p = o else {
        return -1
    }
    var sum = 0
    for v in p.items {
        sum += v
    }
    sum
}

struct Tagged {
    tag: string?
    n: int
}

struct Note {
    text: string?
}

// Counts its calls, to show that the index of a view is worked out once.
tick(var calls: int) -> int {
    calls += 1
    0
}

main() {
    var pool = Pool()
    in pool.mem {
        pool.items = [1, 2, 4]
    }
    let level = Level(pool: pool)
    print(level.size(), total(level.pool))
    // A view inside a `par for` body, over an item's field of a list that can't change.
    let tagged = [Tagged(tag: "seven", n: 7), Tagged(tag: none, n: 9)]
    var lens = [0, 0]
    par for i, out in lens {
        let t = tagged[i].tag else {
            continue
        }
        if t == "seven" {
            out = 7
        } else {
            out = 1
        }
    }
    print(lens.len, lens)
    // An index with an effect runs once, where the view is declared, however often the view is used.
    let notes = [Note(text: "first"), Note(text: none)]
    var calls = 0
    let note = notes[tick(var calls)].text else {
        print("no text")
        return
    }
    print(note, note, calls)
    let empty = Level(pool: none)
    let p = empty.pool else {
        print("none")
        return
    }
    print(p.items.len)
}
