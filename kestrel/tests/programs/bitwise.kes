// expect: 8 14 6 -6 40 5
// expect: 255 15 240 -4
// expect: 2147483647
// expect: 6 12
// expect: 45286
// expect: 9
// expect-exit: 101
// expect-stderr: shift amount out of range on line 29
main() {
    let a = 12
    let b = 10
    print(a & b, a | b, a ^ b, ~5, 5 << 3, 40 >> 3)
    let m: u8 = 255
    print(m, m >> 4, m << 4, -8 >> 1)
    print(~(1 << 31))
    var f = 7
    f &= 6
    let g = f
    f <<= 1
    print(g, f)
    var h = 0
    for c in [3, 1, 4, 1, 5] {
        h = ((h << 5) ^ (h >> 2) ^ c) & 0xFFFF
    }
    print(h)
    let wide: i64 = 1
    print(1 + 3 << 2 >> 1 | 1 & 1)
    let n = 33
    print(wide << 40 > 0, 1 << n)
}
