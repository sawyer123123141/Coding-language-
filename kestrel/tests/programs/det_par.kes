// Determinism: a float-heavy `par for` over 10,000 items, then the `checksum` of the result. Each
// item depends only on itself, so the line must not change with the thread count or the build.
struct Cell {
    x: f64
    y: float
    p: vec2
    n: int
}

pure work(var c: Cell) {
    var acc = c.x
    for k from 0 to 20 {
        acc = acc + sin(acc * 0.5 + f64(k)) * cos(f64(c.y) + acc * 0.25)
        acc = acc + log(1.0 + abs(acc)) - exp(-abs(acc) * 0.1) + pow(abs(acc) + 1.0, 0.3)
    }
    c.x = acc
    c.y = c.y * 0.5 + float(sqrt(abs(acc)))
    c.p = vec2(cos(c.y), sin(c.y)) * float(atan2(acc, 3.0))
    c.n += int(abs(acc)) % 1000
}

main() {
    var cells: list[Cell] = []
    for i from 0 to 10000 {
        cells.add(Cell(x: f64(i) * 0.001, y: float(i % 97) * 0.1, p: vec2(0, 0), n: i))
    }
    par for c in cells {
        work(var c)
    }
    print(checksum(cells))
    print(cells[0].x, cells[4999].y, cells[9999].p, cells[9999].n)
}
// expect: 1766166045610435347
// expect: 107.53390010538739 14.513191 vec2(x: 1.3409494, y: 0.78174263) 10160
