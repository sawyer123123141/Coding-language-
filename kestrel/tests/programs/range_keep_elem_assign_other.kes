// expect-exit: 101
// expect-stderr: index 2 out of bounds for length 0 on line 11
// `a = []` empties a row of `grid`, which may be the row `b` that was guarded: here it is.
main() {
    var grid: list[list[int]] = [[1, 2, 3], [4, 5, 6]]
    var s = 0
    for a in grid {
        for b in grid {
            if b.len > 2 {
                a = []
                s += b[2]
            }
        }
    }
    print(s)
}
