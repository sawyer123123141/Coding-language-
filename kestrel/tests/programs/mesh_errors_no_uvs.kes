// env: KESTREL_HEADLESS=1
// expect: window.open 64 64 "t"
// expect: draw3d.make_mesh MeshData(vertices: 3, colors: 3, uvs: 0, indices: 3)
// expect: draw.make_texture 1 1 1
// expect: draw3d.camera Camera(pos: vec3(x: 0, y: 0, z: -3), target: vec3(x: 0, y: 0, z: 0), up: vec3(x: 0, y: 1, z: 0), fov: 75)
// expect-exit: 101
// expect-stderr: draw3d.mesh_textured needs a mesh made with uvs on line 20
use window
use draw
use draw3d
use { Camera, MeshData from draw3d }

main() {
    window.open(64, 64, "t")
    var data = MeshData()
    data.triangle(vec3(0, 0, 0), vec3(1, 0, 0), vec3(0, 1, 0), draw.RED)
    let m = draw3d.make_mesh(data)
    let tex = draw.make_texture(1, 1, [draw.WHITE])
    draw3d.camera(Camera(pos: vec3(0, 0, -3), target: vec3(0, 0, 0)))
    draw3d.mesh_textured(m, tex, vec3(0, 0, 0), draw.WHITE)
}
