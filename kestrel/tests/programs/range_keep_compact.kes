// expect-exit: 101
// expect-stderr: index 2 out of bounds for length 1 on line 12
// A `remove b` loop removes items: the length from before it says nothing after.
main() {
    var xs: list[int] = [1, 2, 3]
    let n = xs.len
    for b in xs {
        if b > 1 {
            remove b
        }
    }
    print(xs[n - 1])
}
