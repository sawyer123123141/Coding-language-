// env: KESTREL_HEADLESS=1
// expect: window.open 64 64 "t"
// expect: draw3d.make_mesh MeshData(vertices: 3, colors: 3, uvs: 0, indices: 3)
// expect-exit: 101
// expect-stderr: draw3d.mesh needs a camera; call draw3d.camera first on line 17
use window
use draw
use draw3d
use { MeshData from draw3d }

main() {
    window.open(64, 64, "t")
    var data = MeshData()
    data.triangle(vec3(0, 0, 0), vec3(1, 0, 0), vec3(0, 1, 0), draw.RED)
    // make_mesh draws nothing, so it needs no camera; drawing the mesh does.
    let m = draw3d.make_mesh(data)
    draw3d.mesh(m, vec3(0, 0, 0), draw.WHITE)
}
