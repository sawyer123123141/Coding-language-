// expect-exit: 101
// expect-stderr: index 2 out of bounds for length 1 on line 9
// A pop inside the loop shortens the list the loop's end was worked out from.
main() {
    var xs: list[int] = [1, 2, 3, 4]
    var s = 0
    for i from 0 to xs.len {
        xs.pop()
        s += xs[i]
    }
    print(s)
}
