// `remove` in loops over lists of other kinds of items, in methods, in nested loops, and around
// `arena { }` blocks.
// env: KESTREL_ARENA_COUNT=1
// expect: 30 3 3
// expect: World(bricks: [2, 4], score: 3)
// expect: 3 [1]
// expect: [[1, 3], [5]]
// expect: [1]
// expect: [2.5, 3.5]
// expect: [true, true]
// expect: [vec2(x: 1, y: 2)]
// expect: 10 2
// expect-stderr: arenas alive at exit: 0
struct Pool {
    mem: Arena = Arena()
    n: int
}

struct Bag {
    items: list[Pool]
    nums: list[int]

    prune(var self, limit: int) {
        for p in self.items { if p.n > limit { remove p } }
    }
}

struct World {
    bricks: list[int]
    score: int = 0
}

first_big(var ps: list[Pool]) -> int {
    for p in ps {
        if p.n > 2 { return p.n * 10 }
        remove p
    }
    0
}

drop_odd(var w: World) {
    for b in w.bricks { if b % 2 == 1 { w.score += 1; remove b } }
}

main() {
    var ps: list[Pool] = []
    for i from 1 to 6 { ps.add(Pool(n: i)) }
    print(first_big(var ps), ps.len, ps[0].n)
    var w = World(bricks: [1, 2, 3, 4, 5])
    drop_odd(var w)
    print(w)
    var bag = Bag(items: [], nums: [1])
    for i from 1 to 6 { bag.items.add(Pool(n: i)) }
    bag.prune(3)
    print(bag.items.len, bag.nums)
    var grid: list[list[int]] = [[1, 2, 3], [], [4], [5, 6]]
    for row in grid {
        for x in row { if x % 2 == 0 { remove x } }
        if row.len == 0 { remove row }
    }
    print(grid)
    var opts: list[int?] = [1, none, 3]
    for o in opts {
        let v = o else { remove o; continue }
        if v == 3 { remove o }
    }
    print(opts)
    var fs: list[float] = [1.5, 2.5, 3.5]
    for i, f in fs { if i == 0 { remove f } }
    print(fs)
    var bs: list[bool] = [true, false, true]
    for b in bs { if not b { remove b } }
    print(bs)
    var vs: list[vec2] = [vec2(1, 2), vec2(3, 4)]
    for v in vs { if v.x > 2 { remove v } }
    print(vs)
    var total = 0
    var nested: list[Pool] = []
    for i from 1 to 5 { nested.add(Pool(n: i)) }
    for p in nested {
        arena {
            let tmp: list[int] = [p.n, p.n]
            total += tmp[0]
            if p.n == 2 { remove p; continue }
        }
        if p.n == 4 { remove p; break }
    }
    print(total, nested.len)
}
