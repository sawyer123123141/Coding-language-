// expect-exit: 101
// expect-stderr: index 2 out of bounds for length 2 on line 10
// `xs.len` is read before the inlined call pops, and the index checked after: two values.
drop0(var xs: list[int]) -> int {
    xs.pop()
    0
}
main() {
    var xs: list[int] = [1, 2, 3]
    print(xs[int(u8(xs.len - 1)) + drop0(var xs)])
}
