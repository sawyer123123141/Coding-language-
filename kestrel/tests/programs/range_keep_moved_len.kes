// expect-exit: 101
// expect-stderr: index 1 out of bounds for length 1 on line 11
// `a` and `b` may be different rows: `a.add(0)` makes `b` longer only when they are the same.
main() {
    var grid: list[list[int]] = [[1], [2]]
    var s = 0
    for a in grid {
        for b in grid {
            let n = b.len
            a.add(0)
            s += b[n]
        }
    }
    print(s)
}
