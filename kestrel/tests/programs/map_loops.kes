// expect: 2 {1: 1, 3: 3}
// expect: {1: 1}
// expect: 5 6
// expect: 7 4
main() {
    // Removing during a loop is fine, the current key included.
    var m = {1: 1, 2: 2, 3: 3}
    for k, v in m {
        if k == 2 { m.remove(k) }
    }
    print(m.len, m)
    for k, v in m {
        if k == 3 {
            m.remove(k)
            break
        }
    }
    print(m)
    // Replacing a value is fine too; the loop's `v` sees the new one.
    var n = {1: 5}
    for k, v in n {
        let before = v
        n[k] = v + 1
        print(before, v)
    }
    var scores = {1: 3, 2: 7, 3: 9}
    let big = first_big(var scores)
    // Still unlocked after the `return`: adding a key works.
    scores[50] = 1
    print(big, scores.len)
}

// `return` inside the loop unlocks the map.
first_big(var m: map[int, int]) -> int {
    for k, v in m {
        if v > 5 { return v }
    }
    m[100] = 0
    -1
}
