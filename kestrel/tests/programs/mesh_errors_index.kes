// env: KESTREL_HEADLESS=1
// expect: window.open 64 64 "t"
// expect-exit: 101
// expect-stderr: draw3d.make_mesh got index 4, but there are only 4 vertices on line 15
use window
use draw
use draw3d
use { MeshData from draw3d }

main() {
    window.open(64, 64, "t")
    var data = MeshData()
    data.quad(vec3(0, 0, 0), vec3(1, 0, 0), vec3(1, 1, 0), vec3(0, 1, 0), draw.RED)
    data.indices[5] = 4
    let m = draw3d.make_mesh(data)
}
