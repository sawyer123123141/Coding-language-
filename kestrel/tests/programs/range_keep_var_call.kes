// expect-exit: 101
// expect-stderr: index 2 out of bounds for length 2 on line 23
// A `var` call between the guard and the index shortens the list.
id(x: int, d: int) -> int {
    if d == 0 {
        return x
    }
    id(x, d - 1)
}
shrink(var xs: list[int], n: int) {
    if n == 0 {
        return
    }
    xs.pop()
    shrink(var xs, n - 1)
}
main() {
    var xs: list[int] = [1, 2, 3]
    let i = id(2, 1)
    var s = 0
    if i < xs.len and i >= 0 {
        shrink(var xs, 1)
        s = xs[i]
    }
    print(s)
}
