// A hex literal may use its type's full width: `0x9E3779B1` is an `int`'s bit pattern.
main() {
    let PRIME = 0x9E3779B1
    print(PRIME, 1 *% PRIME, 0x9E3779B1 *% 5)
    var h = 7
    h *%= 0x9E3779B1
    print(h)
    let w: i64 = 3
    print(w *% 0x9E3779B97F4A7C15)
    let x: i64 = 0xFFFFFFFF
    print(x, i64(0xFFFFFFFF), 0xFFFFFFFF)
    // Next to a float, a literal is the float it spells, on either side; a variable holding it is an `int`: -1.
    let y = 0xFFFFFFFF
    let d: f64 = 1.5
    print(y * 1.5, 0xFFFFFFFF * 1.5, 1.5 * 0xFFFFFFFF)
    print(0xFFFFFFFF * d, d * 0xFFFFFFFF)
    // Meeting an `i64`, a hex literal is read as an `i64`, whichever side it is on.
    print(0xFFFFFFFF + w, w + 0xFFFFFFFF, 0xFFFFFFFF *% w, w *% 0xFFFFFFFF)
    print(0xFFFFFFFF < w, w < 0xFFFFFFFF, 0xFFFFFFFF & w, w & 0xFFFFFFFF)
    // Next to a `u8` it is an `int`, as any literal is.
    let c: u8 = 3
    print(0xFFFFFFFF + c, 7 *% c)
    // Dividing by the `int` -1 is still checked: 10 / -1 is fine.
    var ten = 10
    ten /= 0xFFFFFFFF
    print(ten)
}

// expect: -1640531535 -1640531535 387276917
// expect: 1401181143
// expect: -2691343689449507777
// expect: 4294967295 4294967295 -1
// expect: -1.5 6442451000 6442451000
// expect: 6442450942.5 6442450942.5
// expect: 4294967298 4294967298 12884901885 12884901885
