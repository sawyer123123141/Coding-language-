// Wrapping operators keep no check, so a contract that forbids checks holds for a hash.
@prove(no_checks, no_panic)
pure mix32(h: int) -> int {
    var x = h
    x = (x ^ (x >> 16)) *% 0x45D9F3B
    x = (x ^ (x >> 16)) *% 0x45D9F3B
    x ^ (x >> 16)
}

main() {
    print(mix32(1))
}

// expect: 824515495
