// The left side of a vector operator is read before the right side runs, as for numbers, even
// when the right side changes it.
gi(var n: int) -> ivec2 {
    n += 100
    ivec2(1, 2)
}

gv(var v: vec2) -> vec2 {
    v = vec2(100, 100)
    vec2(1, 2)
}

grow(var v: ivec2) -> int {
    v = ivec2(50, 60)
    1
}

main() {
    var n = 1
    print(n - gi(var n), n)
    n = 1
    print(n * gi(var n))
    var v = vec2(5, 6)
    print(v - gv(var v), v)
    var w = ivec2(1, 2)
    print(w + grow(var w), w)
    w = ivec2(1, 2)
    w += grow(var w)
    print(w)
}

// expect: ivec2(x: 0, y: -1) 101
// expect: ivec2(x: 1, y: 2)
// expect: vec2(x: 4, y: 4) vec2(x: 100, y: 100)
// expect: ivec2(x: 2, y: 3) ivec2(x: 50, y: 60)
// expect: ivec2(x: 2, y: 3)
