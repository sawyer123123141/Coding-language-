main() {
    let a = vec4(1, 2, 3, 4)
    let b = vec4(0.5)
    let c = a * b + a
    print(c, c.x)
    var d = c
    d.w = 9
    d.x += 1
    print(d, d.wzyx, d.xy, d.xyz, vec3(1, 2, 3).xyzz, vec4())
    print(vec4(vec3(1, 2, 3), 4), vec4(vec2(1, 2), 3, 4), vec4(vec2(1, 2), vec2(3, 4)))
    print(a / 2, 12 / a, -a, a - 1, 1 - a)
    print(a == vec4(1, 2, 3, 4), a != vec4(1, 2, 3, 5), a == vec4(1, 2, 3, 5))
    print("v = {a}")
    print(vec4(x: 1, y: 2, z: 3, w: 4), vec4(w: 4, z: 3, y: 2, x: 1), vec4(1, y: 2, z: 3, w: 4))
    var e = vec4(1, 2, 3, 4)
    e *= 2
    e /= 4
    e += 1
    e -= 0.5
    print(e)
    let n = vec4(0) / 0
    let p = vec4(1, 2, 3, 0) / vec4(1, 1, 1, 0)
    print(n == n, n != n, p == p, p != p)
}
// expect: vec4(x: 1.5, y: 3, z: 4.5, w: 6) 1.5
// expect: vec4(x: 2.5, y: 3, z: 4.5, w: 9) vec4(x: 9, y: 4.5, z: 3, w: 2.5) vec2(x: 2.5, y: 3) vec3(x: 2.5, y: 3, z: 4.5) vec4(x: 1, y: 2, z: 3, w: 3) vec4(x: 0, y: 0, z: 0, w: 0)
// expect: vec4(x: 1, y: 2, z: 3, w: 4) vec4(x: 1, y: 2, z: 3, w: 4) vec4(x: 1, y: 2, z: 3, w: 4)
// expect: vec4(x: 0.5, y: 1, z: 1.5, w: 2) vec4(x: 12, y: 6, z: 4, w: 3) vec4(x: -1, y: -2, z: -3, w: -4) vec4(x: 0, y: 1, z: 2, w: 3) vec4(x: 0, y: -1, z: -2, w: -3)
// expect: true true false
// expect: v = vec4(x: 1, y: 2, z: 3, w: 4)
// expect: vec4(x: 1, y: 2, z: 3, w: 4) vec4(x: 1, y: 2, z: 3, w: 4) vec4(x: 1, y: 2, z: 3, w: 4)
// expect: vec4(x: 1, y: 1.5, z: 2, w: 2.5)
// expect: false true false true
