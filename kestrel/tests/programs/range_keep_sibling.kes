// expect: 1500000001
// expect-exit: 101
// expect-stderr: value doesn't fit in int on line 26
// `half(x)` (inlined) narrows its copy of `x` and `int(x)` narrows `x`; their sibling
// `bump(var x, 1)` then triples `x`, so neither teaches anything after the statement.
id64(x: i64, d: int) -> i64 {
    if d == 0 {
        return x
    }
    id64(x, d - 1)
}
pure half(x: i64) -> int {
    int(x) / 2
}
bump(var x: i64, d: int) -> i64 {
    if d == 0 {
        x = x * 3
        return 1
    }
    bump(var x, d - 1)
}
main() {
    var x = id64(1000000000, 1)
    let t = half(x) + int(x) + int(bump(var x, 1))
    print(t)
    print(int(x))
}
