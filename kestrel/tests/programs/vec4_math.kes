// The lane-by-lane and across-lane built-ins of `vec4` and `ivec4`; the vector `round` agrees with
// the scalar one lane by lane (halves away from zero, and 0.49999997 stays below).
main() {
    let v = vec4(-1.5, 2.25, 9, 0.5)
    print(abs(v), floor(v), ceil(v), round(v))
    print(sqrt(vec4(4, 9, 16, 0)), min(v, 1), max(v, vec4(0)), clamp(v, -1, 2))
    print(lerp(vec4(0), vec4(10, 20, 30, 40), 0.25))
    let iv = ivec4(-3, 4, 7, 0)
    print(abs(iv), min(iv, 5), max(iv, ivec4(0)), clamp(iv, 0, 5))
    print(v.sum(), iv.sum(), vec4(1, 2, 3, 4).dot(vec4(2)), vec4(2, 0, 0, 0).length())
    print(vec4(0, 3, 0, 4).normalized(), vec4().normalized(), vec4(1).distance_to(vec4(1, 1, 1, 3)))
    print(round(vec4(2.5, -2.5, 0.49999997, -0.5)))
    print(round(2.5), round(-2.5), round(0.49999997), round(-0.5))
}

// expect: vec4(x: 1.5, y: 2.25, z: 9, w: 0.5) vec4(x: -2, y: 2, z: 9, w: 0) vec4(x: -1, y: 3, z: 9, w: 1) vec4(x: -2, y: 2, z: 9, w: 1)
// expect: vec4(x: 2, y: 3, z: 4, w: 0) vec4(x: -1.5, y: 1, z: 1, w: 0.5) vec4(x: 0, y: 2.25, z: 9, w: 0.5) vec4(x: -1, y: 2, z: 2, w: 0.5)
// expect: vec4(x: 2.5, y: 5, z: 7.5, w: 10)
// expect: ivec4(x: 3, y: 4, z: 7, w: 0) ivec4(x: -3, y: 4, z: 5, w: 0) ivec4(x: 0, y: 4, z: 7, w: 0) ivec4(x: 0, y: 4, z: 5, w: 0)
// expect: 10.25 8 20 2
// expect: vec4(x: 0, y: 0.6, z: 0, w: 0.8) vec4(x: 0, y: 0, z: 0, w: 0) 2
// expect: vec4(x: 3, y: -3, z: 0, w: -1)
// expect: 3 -3 0 -1
