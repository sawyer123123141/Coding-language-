// A pop after the assumption ends what it says about `xs.len`: the index keeps its check.
id(x: int, d: int) -> int {
    if d == 0 { return x }
    id(x, d - 1)
}

main() {
    var xs: list[int] = [1, 2, 3]
    let i = id(2, 1)
    @assume(i >= 0 and i < xs.len)
    xs.pop()
    print(xs[i])
}
// expect-exit: 101
// expect-stderr: index 2 out of bounds for length 2 on line 12
