// expect-exit: 101
// expect-stderr: index 100000 out of bounds for length 3 on line 25
// The inlined `lenof` reads `xs.len` before the pop, the right side after it.
id(x: int, d: int) -> int {
    if d == 0 {
        return x
    }
    id(x, d - 1)
}
lenof(xs: list[int]) -> int {
    let n = xs.len
    n
}
drop0(var xs: list[int]) -> int {
    xs.pop()
    0
}
main() {
    var xs: list[int] = [1, 2, 3]
    let ys: list[int] = [7, 8, 9]
    var k = 0
    if lenof(xs) + drop0(var xs) > xs.len {
        k = 100000
    }
    print(ys[k])
}
