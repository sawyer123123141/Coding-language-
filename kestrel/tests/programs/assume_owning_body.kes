// An assumption in a function body with an owning local (an arena freed at the end): with a tail
// value, with `return ys`, and inside a closure's body.
pure total(xs: [int], n: int) -> int {
    var a = Arena()
    var s = 0
    @assume(n >= 0 and n <= xs.len)
    in a {
        let tmp = [1, 2]
        s += tmp.len
    }
    for i from 0 to n {
        s += xs[i]
    }
    s
}

evens(xs: [int], n: int) -> list[int] {
    var a = Arena()
    var ys: list[int] = []
    @assume(n >= 0 and n <= xs.len)
    in a {
        let tmp = [3]
        ys.add(tmp.len)
    }
    for i from 0 to n {
        if xs[i] % 2 == 0 {
            ys.add(xs[i])
        }
    }
    return ys
}

main() {
    let xs = [1, 2, 3, 4, 5, 6]
    print(total(xs, 4))
    print(evens(xs, 5))
    let pick = (i: int) -> int {
        @assume(i >= 0 and i < xs.len)
        xs[i] * 10
    }
    print(pick(2))
    var s = 0
    for k from 0 to 3 {
        s += pick(k)
    }
    print(s)
}
// expect: 12
// expect: [1, 2, 4]
// expect: 30
// expect: 60
