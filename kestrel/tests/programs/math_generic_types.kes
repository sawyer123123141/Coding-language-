// expect: 5000000000 -1 -5000000000 2 -10
// expect: 0 0 200 7 200 150
// expect: 2.5 -1 1 3.141592653589793 2
// expect: 3.25 vec3(x: 0.5, y: 1, z: 2)
// expect: 9 0.5
// expect: 5 5 vec2(x: 0.6, y: 0.8) 0
// expect: vec2(x: 6, y: 8) 10
// expect: -3 3
top() -> int {
    TOP
}

struct Body {
    pos: vec2
    vel: vec2
}

doubled(v: vec2) -> vec2 {
    v * 2
}

let TOP = max(3, 9)
let HALF = lerp(0.0, 1.0, 0.5)

main() {
    let big: i64 = -5000000000
    print(abs(big), sign(big), min(big, 3), max(2, big), clamp(big, -10, 10))
    let small: u8 = 0
    let tall: u8 = 200
    print(abs(small), sign(small), abs(tall), min(tall, 7), max(tall, 100), clamp(tall, 10, 150))
    let wide: f64 = 2.5
    print(abs(-wide), sign(-wide), min(wide, 1), max(wide, PI), clamp(wide, 0, 2))
    print(lerp(wide, 4, 0.5), lerp(vec3(0, 0, 0), vec3(2, 4, 8), 0.25))
    print(top(), HALF)
    let b = Body(pos: vec2(3, 4), vel: vec2(0, 0))
    print(b.pos.length(), vec3(0, 3, 4).xz.length() + vec2(3, 4).xy.length() - 4, b.pos.normalized(), b.vel.normalized().length())
    print(doubled(b.pos), doubled(b.pos).length())
    let x = -3
    print(x, abs(x))
}
