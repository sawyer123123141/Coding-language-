// expect: true
// expect: true
// expect: 0.010000000000000002
// expect: 0.010000000000000002
// expect: -0.010000000000000002
// expect: 0.2
// expect: 0.30000000000000004
// expect: true
main() {
    let x: f64 = 0.1
    print(x == 0.1)
    print(0.1 == x)
    print(0.1 * x)
    print(x * 0.1)
    print(-0.1 * x)
    print(0.1 + x)
    print(3 * x)
    print(-0.1 == -x)
}
