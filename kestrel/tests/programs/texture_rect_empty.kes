// env: KESTREL_HEADLESS=1
// expect: window.open 64 64 "t"
// expect-exit: 101
// expect-stderr: draw.texture_rect got an empty texture; make one with draw.load_texture or draw.make_texture on line 13
use window
use draw
use { Texture from draw }

main() {
    window.open(64, 64, "t")
    // A zero-filled array holds empty textures: their id is 0, which is no GPU object.
    let empty = array[Texture](2)
    draw.texture_rect(empty[0], vec2(0, 0), vec2(8, 8), draw.WHITE)
}
