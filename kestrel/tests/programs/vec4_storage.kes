struct Body {
    id: u8
    pos: vec4
    vel: vec4 = vec4(0, 1, 0, 0)
}

struct B {
    p: vec4
}

let K = vec4(1, 2, 3, 4)

bump(var v: vec4) {
    v.x += 1
}

pass(a: vec4, b: vec4, c: vec4, d: vec4, e: vec4, n: int) -> vec4 {
    if n == 0 {
        return a + b + c + d + e
    }
    pass(b, c, d, e, a, n - 1)
}

id(x: int, d: int) -> int {
    if d == 0 {
        return x
    }
    id(x, d - 1)
}


enum Shape {
    Dot
    Ball { at: vec4, r: float }
}

apply(f: () -> vec4) -> vec4 {
    f()
}

grow(var x: float) {
    x *= 10
}

more() {
    let k = vec4(1, 2, 3, 4)
    let u: u8 = 7
    print(apply(() -> vec4 { k * float(u) }))
    var arr = [vec4(1), vec4(2, 3, 4, 5)]
    arr[1].z = 0
    grow(var arr[0].y)
    print(arr, arr[1].wzyx.x)
    var s = Shape.Ball(at: vec4(1, 3, 3, 4), r: 2)
    match s {
        Ball b { b.at.w = 0 }
        Dot { }
    }
    match s {
        Ball b { print(b.at.y * b.r, b.at) }
        Dot { print("dot") }
    }
}

main() {
    var b = Body(id: 1, pos: vec4(1, 2, 3, 4))
    b.pos += b.vel
    b.pos.w = 0
    bump(var b.pos)
    print(b)

    var vs = list[vec4]()
    for i from 0 to 3 {
        vs.add(vec4(i))
    }
    vs[2].y = 7
    print(vs, vs.has(vec4(1)), vs.has(vec4(5)))

    let double = (v: vec4) -> vec4 { v * 2 }
    let k = vec4(1, 2, 3, 4)
    let plus = () -> vec4 { k + 1 }
    var fs = list[() -> vec4]()
    fs.add(plus)
    let h = fs[0]
    print(double(k), plus(), h())

    print(pass(vec4(1), vec4(2), vec4(3), vec4(4), vec4(5), 3))

    var m = map[int, vec4]()
    m[3] = vec4(3, 2, 1, 0)
    let got = m[3] else {
        return
    }
    print(got, got.z)

    var o: vec4? = none
    print(o)
    o = vec4(9)
    print(o)

    print(K, K.w, K.wzyx)

    par for v in vs {
        v = v * 2
        v.w = 1
    }
    print(vs)

    let bb = if id(1, 2) > 0 { B(p: vec4(1)) } else { B(p: vec4(2)) }
    print(bb, bb.p.y)

    for v in vs {
        if v.x > 0.5 {
            remove v
        }
    }
    print(vs)
    more()
}
