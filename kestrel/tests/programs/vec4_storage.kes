// expect: [vec4(x: 0, y: 0, z: 0, w: 0), vec4(x: 1, y: 1, z: 1, w: 1), vec4(x: 2, y: 7, z: 2, w: 2)] true false
// expect: vec4(x: 2, y: 4, z: 6, w: 8) vec4(x: 2, y: 3, z: 4, w: 5) vec4(x: 2, y: 3, z: 4, w: 5)
// expect: vec4(x: 15, y: 15, z: 15, w: 15)
// expect: vec4(x: 3, y: 2, z: 1, w: 0) 1
// expect: none
// expect: vec4(x: 9, y: 9, z: 9, w: 9)
