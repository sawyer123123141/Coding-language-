// expect: [vec4(x: 0, y: 0, z: 0, w: 1), vec4(x: 2, y: 2, z: 2, w: 1), vec4(x: 4, y: 14, z: 4, w: 1)]
// expect: B(p: vec4(x: 1, y: 1, z: 1, w: 1)) 1
