// expect: 0.47942555 0.87758255 0.5880026 1.6487212 -0.6931472 1.118034
// expect: 0.84147096 0.5403023 0.9272952 2.7182817 0 1.25
// expect: 0.5984721 -0.8011436 1.2793396 12.182494 0.91629076 1.7469281
// expect: -0.14112 -0.9899925 -1.3258177 0.049787067 NaN 0.512
// expect: -0.50636566 0.8623189 1.5632964 inf 4.6051702 4909093400
// expect: 0.14539565 -0.98937356 1.5701888 inf 7.118421 inf
main() {
    let z: f64 = 0
    let inf = 1 / z
    let nan = z / z
    let one: f64 = 1
    let third = one / 3
    let e300: f64 = .0
    let e22: f64 = 10000000000000000000000.0
    let e_300: f64 = 0.
    let e_310: f64 = 0.
    let sub: f64 = 0.
    let trig: list[f64] = [z, -z, e_300, sub, 0.5, 1.0, 2.0, 3.0, -3.0, 0.7853981633974483, 100.0, 1000000.0, e22, e300, inf, -inf, nan]
    for x in trig {
        print(sin(x))
    }
    for x in trig {
        print(cos(x))
    }
    for x in trig {
        print(tan(x))
    }
    let unit: list[f64] = [-1.0, -0.5, -z, z, 0.3, 0.5, 0.99999, 1.0, 1.5, nan]
    for x in unit {
        print(asin(x))
    }
    for x in unit {
        print(acos(x))
    }
    let tangents: list[f64] = [z, -z, 0.5, 1.0, -1.0, 10000000000.0, -e300, inf, nan]
    for x in tangents {
        print(atan(x))
    }
    let ys: list[f64] = [z, z, -z, 1.0, -1.0, 1.0, -1.0, z, -z, inf, 1.0, nan]
    let xs: list[f64] = [1.0, -1.0, -1.0, z, z, 1.0, -1.0, z, -z, inf, inf, 1.0]
    for i from 0 to ys.len {
        print(atan2(ys[i], xs[i]))
    }
    let exponents: list[f64] = [z, 1.0, -1.0, 0.5, 10.0, 709.78, 710.0, -745.1, -746.0, inf, -inf, nan]
    for x in exponents {
        print(exp(x))
    }
    let logs: list[f64] = [1.0, 2.0, 0.5, 10.0, e_310, e300, z, -z, -1.0, inf, nan]
    for x in logs {
        print(log(x))
    }
    let bases: list[f64] = [2.0, 2.0, 10.0, -8.0, -8.0, z, nan, 1.0, 1.0000001, 2.0, 2.0, 0.5]
    let powers: list[f64] = [0.5, 10.0, -3.0, third, 3.0, z, z, nan, 10000000.0, 1024.0, -1075.0, -1074.0]
    for i from 0 to bases.len {
        print(pow(bases[i], powers[i]))
    }
    let nums: list[f64] = [7.5, -7.5, e300, sub, 1.0, inf, 1.0, -z]
    let divs: list[f64] = [2.0, 2.0, 3.0, 1.0, z, 1.0, inf, 1.0]
    for i from 0 to nums.len {
        print(nums[i] % divs[i])
    }
    let floats: list[float] = [0.5, 1.0, 2.5, -3.0, 100.0, 1234.5]
    for x in floats {
        print(sin(x), cos(x), atan2(x, 0.75), exp(x), log(x), pow(1.25, x))
    }
}
