// expect-exit: 101
// expect-stderr: index 2 out of bounds for length 0 on line 10
// `row = []` inside `for k, row in grid` empties `grid[k]`, after the guard on `grid[k].len`.
main() {
    var grid: list[list[int]] = [[1, 2, 3], [4, 5, 6]]
    var s = 0
    for k, row in grid {
        if grid[k].len > 2 {
            row = []
            s += grid[k][2]
        }
    }
    print(s)
}
