// The engine's own parity (E20): the frozen benchmark's region built through the engine's
// pipeline. Columns -1..8 by -1..8 are generated into the world's pool, and every chunk of
// columns 0..7 is meshed by `mesh_chunk` from the stored blocks.
//
// It counts 465,576 faces, 1,827 more than the frozen world's 463,749: the frozen mesher takes
// the row above y = 127 from the terrain function, so a y = 127 block under solid terrain has no
// top face, while the engine's mesher treats that row as air, as `World.block` (and so the
// player and the ray) does (E70). Every extra face is such a top face. The frozen count stays
// pinned by `tests/parity.kes` (the frozen work on the libraries) and the race (`race.kes`).
//
// only-jit: it generates 100 columns and meshes 256 chunks; the JIT and release passes
// cover it, and the executable pass would do the same work again for nothing new.
use { World, new_world, load_now from world }
use { mesh_chunk, faces from mesher }
use { LAYERS from blocks }

main() {
    var w = new_world(1337, 100)
    for cz from -1 to 9 {
        for cx from -1 to 9 {
            load_now(var w, cx, cz)
        }
    }
    var total = 0
    for cx from 0 to 8 {
        for layer from 0 to LAYERS {
            for cz from 0 to 8 {
                let slot = w.slot_at(cx, cz)
                arena {
                    total += faces(mesh_chunk(w, slot, layer))
                }
            }
        }
    }
    print(total)
}
// expect: 465576
// release
// only-jit
