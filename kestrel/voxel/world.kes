// The world: every loaded column, in a pool of slots, found by its key (E11). It answers
// "which block is at (x, y, z)" for the whole world, across columns and for negative x and
// z, and takes edits. It also holds each chunk's meshing state and the queue of chunks
// waiting for a mesh, which streaming (`stream.kes`) fills and rendering empties.
//
// In GDScript terms it is the node that owns the chunk dictionary, but the columns don't
// come and go: there is a fixed number of slots (`Pool`), each with a 32 x 128 x 32 grid
// built once, and loading a column rewrites a free slot's grid in place.
//
// Reads go in place through `self.columns.items[slot].blocks.items[i]`: taking a `Column`
// out of the pool into a variable would copy its 128 KB grid.
//
// The world remembers every edit (`edits`), and a column that is loaded gets the edits that fall
// in it written over its generated blocks (`apply_edits_in`). So an edited block is back after
// its column unloads and loads again, and a save needs only the seed, the edits and the player
// (`save.kes`).
use { Solid from grid }
use { Handle, Pool, pool from pool }
use { Ring, ring from ring }
use { Column, ColumnState, column_key, column_of, local, new_column from column }
use { generate from gen }
use { AIR, STONE, SIZE, LAYERS, HEIGHT, is_solid from blocks }

// A chunk's meshing state, one per slot * LAYERS + layer in `World.chunk_state`: not
// meshed and not waiting, waiting in the queue, or meshed.
pub let CHUNK_NONE: u8 = 0
pub let CHUNK_QUEUED: u8 = 1
pub let CHUNK_MESHED: u8 = 2

// A chunk waiting for a mesh: its column's handle (dead if the column unloaded while the
// chunk waited) and which of the column's chunks, 0 at the bottom.
pub struct ChunkRef {
    column: Handle
    layer: int
}

// An edit: block `id` was put at `cell`.
pub struct Edit {
    cell: ivec3
    id: u8
}

pub struct World: Solid {
    seed: int
    columns: Pool[Column]
    // Column key (`column_key`) to slot, for every column that has a slot.
    index: map[i64, int]
    chunk_state: list[u8]
    queue: Ring[ChunkRef]
    // Every cell edited since the world was made or loaded, once each with its latest block, in
    // the order the cells were first edited.
    edits: list[Edit]

    // The slot of column (cx, cz), or -1 when it isn't loaded or isn't Ready yet.
    pure slot_at(self, cx: int, cz: int) -> int {
        let slot = self.index.get(column_key(cx, cz), -1)
        if slot < 0 {
            return -1
        }
        match self.columns.items[slot].state {
            Ready { slot }
            else { -1 }
        }
    }

    // The block at world (x, y, z). Above the world is air and below it stone; a column
    // that isn't Ready counts as stone, so nothing falls or walks into it.
    pure block(self, x: int, y: int, z: int) -> u8 {
        if y >= HEIGHT {
            return AIR
        }
        if y < 0 {
            return STONE
        }
        let slot = self.slot_at(column_of(x), column_of(z))
        if slot < 0 {
            return STONE
        }
        self.columns.items[slot].blocks.items[(y * SIZE + local(z)) * SIZE + local(x)]
    }

    pure solid(self, x: int, y: int, z: int) -> bool {
        is_solid(self.block(x, y, z))
    }

    // Puts block `id` at (x, y, z). Returns false, changing nothing, outside the world's
    // height (0 to 127) or in a column that isn't Ready. It doesn't re-mesh anything:
    // the caller marks the chunks around the cell (`edit.kes`).
    pure set_block(var self, x: int, y: int, z: int, id: u8) -> bool {
        if y < 0 or y >= HEIGHT {
            return false
        }
        let slot = self.slot_at(column_of(x), column_of(z))
        if slot < 0 {
            return false
        }
        self.columns.items[slot].blocks.items[(y * SIZE + local(z)) * SIZE + local(x)] = id
        true
    }

    // Remembers that `cell` now holds block `id`, replacing the cell's earlier edit if it has
    // one, so the list holds each cell once however often it is edited. It scans the edits:
    // its cost is their number, once per edit.
    pure remember(var self, cell: ivec3, id: u8) {
        for i from 0 to self.edits.len {
            if self.edits[i].cell == cell {
                self.edits[i].id = id
                return
            }
        }
        self.edits.add(Edit(cell: cell, id: id))
    }
}

// An empty world with `capacity` column slots, each with its grid built, every chunk state
// CHUNK_NONE and a queue with room for every chunk. The pool is made inside the constructor
// call, not in a local first (E38: a struct made from a local's lists copies them): measured,
// `new_world(1337, 441)` peaks at the same 64 MB as `pool(441, new_column())` alone.
pub new_world(seed: int, capacity: int) -> World {
    let nowhere = ChunkRef(column: Handle(slot: -1, gen: -1), layer: 0)
    var w = World(seed: seed, columns: pool[Column](capacity, new_column()), index: {}, chunk_state: [],
        queue: ring[ChunkRef](capacity * LAYERS, nowhere), edits: [])
    for i from 0 to capacity * LAYERS {
        w.chunk_state.add(CHUNK_NONE)
    }
    w
}

// Empties the world in place and gives it `seed`, as if it had just been made with
// `new_world(seed, capacity)` for the capacity it has: every slot is released (so the slots'
// handles die and the renderer drops their meshes), and the index, the chunk states, the queue
// and the edits are emptied. Loading a save uses it (`save.kes`): making a new world instead
// would leave the old one's grids (128 KB a slot) in the arena.
pub pure reset_world(var w: World, seed: int) {
    for slot from 0 to w.columns.items.len {
        if w.columns.used[slot] {
            w.index.remove(w.columns.items[slot].key)
            w.columns.items[slot].state = ColumnState.Free
            w.columns.release(w.columns.handle(slot))
        }
    }
    for i from 0 to w.chunk_state.len {
        w.chunk_state[i] = CHUNK_NONE
    }
    w.queue.clear()
    w.edits.clear()
    w.seed = seed
}

// Writes every remembered edit in the column in `slot` over its blocks. A column calls it when
// it becomes Ready, after its blocks are generated (`load_now`, and streaming's `finish_jobs`).
// It scans every edit: its cost is the number of edits, once per column loaded. An edit outside
// the world's height (only a damaged save could hold one) is skipped.
pub pure apply_edits_in(var w: World, slot: int) {
    let cx = w.columns.items[slot].cx
    let cz = w.columns.items[slot].cz
    for i from 0 to w.edits.len {
        let c = w.edits[i].cell
        if column_of(c.x) == cx and column_of(c.z) == cz and c.y >= 0 and c.y < HEIGHT {
            w.columns.items[slot].blocks.items[(c.y * SIZE + local(c.z)) * SIZE + local(c.x)] = w.edits[i].id
        }
    }
}

// Loads column (cx, cz) now: takes a slot, generates the column into it in place, writes the
// world's edits in it, marks it Ready and indexes it. Nothing is queued for meshing. This is for tests and for building a
// region at once; streaming loads columns in batches across cores instead (`stream.kes`).
// A column that already has a slot is left as it is.
pub load_now(var w: World, cx: int, cz: int) {
    let key = column_key(cx, cz)
    if w.index.has(key) {
        return
    }
    let h = w.columns.take() else {
        print("load_now: the column pool is full ({w.columns.items.len} slots); make the world with a larger capacity")
        return
    }
    w.columns.items[h.slot].cx = cx
    w.columns.items[h.slot].cz = cz
    w.columns.items[h.slot].key = key
    w.columns.items[h.slot].state = ColumnState.Generating
    generate(var w.columns.items[h.slot].blocks, cx, cz, w.seed)
    apply_edits_in(var w, h.slot)
    w.columns.items[h.slot].state = ColumnState.Ready
    for layer from 0 to LAYERS {
        w.chunk_state[h.slot * LAYERS + layer] = CHUNK_NONE
    }
    w.index[key] = h.slot
}
