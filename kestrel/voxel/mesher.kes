// Meshing (E14): the mesh of one 32 x 32 x 32 chunk of a loaded column, built from the
// world's stored blocks. It is the viewer's mesher (`demos/voxels/world.kes`): a face for
// each side of a solid block that touches air, each corner shaded by ambient occlusion,
// each quad cut along its brighter diagonal, and each block coloured by its type, its face
// direction and a small per-block variation. There is no lighting, as in early Minecraft.
//
// The mesh is a `MeshData` (vertices, colours and indices, like the arrays you fill an
// `ArrayMesh` with in Godot) in chunk-local coordinates, 0 to 32 on each axis: the
// renderer draws it at the chunk's origin, so `float` positions stay exact far from 0.
//
// Every function here is `pure`, so a `par for` can mesh many chunks at once (`render.kes`).
use { Color from draw }
use { MeshData from draw3d }
use { World from world }
use { Grid from grid }
use { lattice from noise }
use { solid_at from gen }
use { AIR, SIZE, PAD, LAYERS, HEIGHT, colour from blocks }

// Steps between neighbouring blocks in the padded solid flags (x fastest, then z, then y).
let STEP_X = 1
let STEP_Y = PAD * PAD
let STEP_Z = PAD

// How many blocks a column grid holds.
let CELLS = SIZE * HEIGHT * SIZE

// How bright each side of a block is: the top brightest, the bottom darkest.
let TOP = 1.0
let SIDE_X = 0.8
let SIDE_Z = 0.7
let BOTTOM = 0.5

// How bright a face corner is: NOOK + OCCLUDED * its ambient occlusion (see `occlusion`),
// so 1 with no solid block touching it, 0.85 and 0.7 with one or two, and 0.55 in a nook.
let NOOK = 0.55
let OCCLUDED = 0.15

// The colour variation's own seed, not the world's, so the variation doesn't follow the
// terrain.
let VARIATION_SEED = 7919

// Where chunk `layer` of the column in `slot` keeps its state and its mesh: slot * LAYERS +
// layer, in `World.chunk_state` and the renderer's mesh list.
pub pure chunk_index(slot: int, layer: int) -> int {
    slot * LAYERS + layer
}

// How many faces (quads) a mesh has: each is two triangles, six indices.
pub pure faces(m: MeshData) -> int {
    m.indices.len / 6
}

// A brightness of 0.97 to 1.03 for world block (x, y, z), the same for all its faces, so
// flat ground isn't one flat colour. It must not push a block colour past 1, where
// make_mesh would clip it: the brightest, SNOW's blue, reaches 0.9991.
pub pure variation(x: int, y: int, z: int) -> float {
    1.0 + 0.06 * (lattice(x, y, z, VARIATION_SEED) - 0.5)
}

// `c` at brightness `light` (1 leaves it as it is).
pub pure shaded(c: Color, light: float) -> Color {
    Color(c.r * light, c.g * light, c.b * light, c.a)
}

// 1 when stored block `k` of the column in `slot` is solid, else 0. A column that isn't
// Ready (slot -1) is solid, as `World.block` says.
pure flag(w: World, slot: int, k: int) -> u8 {
    if slot < 0 or w.columns.items[slot].blocks.items[k] != AIR { 1 } else { 0 }
}

// The solid flags of the SIZE stored blocks of column grid `g` from list index `k` on (one
// row along x), written into the padded flags `solid` from index `at`.
//
// The assumptions are what the compiler can't see by itself (E39): the lengths of the two
// lists (every column grid is 32 x 128 x 32, the flags are 34 x 34 x 34) and where a row
// can start. With them every index in the loop is proven and the loop has no checks; both
// builds test the assumptions once per row instead of checking 64 indexes.
pure copy_row(var solid: [u8], at: int, g: Grid[u8], k: int) {
    @assume(g.items.len == CELLS and k >= 0 and k <= CELLS - SIZE)
    @assume(solid.len == PAD * PAD * PAD and at >= 0 and at <= PAD * PAD * PAD - SIZE)
    @prove(no_checks)
    for x from 0 to SIZE {
        solid[at + x] = if g.items[k + x] != AIR { 1 } else { 0 }
    }
}

// Whether the solid block at `i` touches air, so it has a face.
pure exposed(solid: [u8], i: int) -> bool {
    solid[i + STEP_X] == 0 or solid[i - STEP_X] == 0 or solid[i + STEP_Y] == 0 or
        solid[i - STEP_Y] == 0 or solid[i + STEP_Z] == 0 or solid[i - STEP_Z] == 0
}

// The ambient occlusion of a face corner, the classic voxel kind: 3 when no solid block
// touches it, down to 0 in a nook. `front` is the air block the face looks into, and `su`
// and `sv` step from it along the face toward the corner. The three blocks beside the
// corner in that layer are the two sides and the one between them; with both sides solid,
// the corner is a nook whatever the third is.
pure occlusion(solid: [u8], front: int, su: int, sv: int) -> int {
    let side1 = int(solid[front + su])
    let side2 = int(solid[front + sv])
    if side1 == 1 and side2 == 1 {
        0
    } else {
        3 - side1 - side2 - int(solid[front + su + sv])
    }
}

// The step in the solid flags for a move of one block along `v` (an axis, either way).
pure step(v: vec3) -> int {
    int(v.x) * STEP_X + int(v.y) * STEP_Y + int(v.z) * STEP_Z
}

// A chunk's mesh being built: MeshData plus a face whose corners get their own colours,
// like a Godot SurfaceTool with a colour per vertex.
struct Builder {
    data: MeshData

    // One block face: corners a, a + u, a + u + v and a + v, clockwise seen from outside,
    // and `front` the air block it looks into. Each corner is `tint` darkened by its
    // ambient occlusion. A quad is two triangles, and the colour is blended across each,
    // so the cut decides how the shading runs: the quad is cut along the diagonal whose
    // corners are brighter, which keeps a single dark corner a soft round shadow instead
    // of a streak.
    pure face(var self, solid: [u8], front: int, a: vec3, u: vec3, v: vec3, tint: Color) {
        let su = step(u)
        let sv = step(v)
        let ao_a = occlusion(solid, front, -su, -sv)
        let ao_b = occlusion(solid, front, su, -sv)
        let ao_c = occlusion(solid, front, su, sv)
        let ao_d = occlusion(solid, front, -su, sv)
        let base = self.data.vertices.len
        self.data.vertices.add(a)
        self.data.vertices.add(a + u)
        self.data.vertices.add(a + u + v)
        self.data.vertices.add(a + v)
        self.data.colors.add(shaded(tint, NOOK + OCCLUDED * ao_a))
        self.data.colors.add(shaded(tint, NOOK + OCCLUDED * ao_b))
        self.data.colors.add(shaded(tint, NOOK + OCCLUDED * ao_c))
        self.data.colors.add(shaded(tint, NOOK + OCCLUDED * ao_d))
        if ao_a + ao_c < ao_b + ao_d {
            // Cut along b d: the triangles b c d and b d a, still clockwise.
            self.data.indices.add(base + 1)
            self.data.indices.add(base + 2)
            self.data.indices.add(base + 3)
            self.data.indices.add(base + 1)
            self.data.indices.add(base + 3)
            self.data.indices.add(base)
        } else {
            // Cut along a c: the triangles a b c and a c d, as MeshData.quad does.
            self.data.indices.add(base)
            self.data.indices.add(base + 1)
            self.data.indices.add(base + 2)
            self.data.indices.add(base)
            self.data.indices.add(base + 2)
            self.data.indices.add(base + 3)
        }
    }
}

// The mesh of chunk `layer` (0 at the bottom) of the column in `slot`, which must be Ready.
//
// First it copies the chunk's solid flags plus a one-block border, 34 x 34 x 34, into
// `solid`: the border comes from the 8 columns around (a column that isn't Ready is solid).
// The row above y = 127 is air, as `World.block` says (the player walks on it and the ray
// passes through it), so a block at y = 127 always has a top face (E70; the frozen world
// takes that row from the terrain function, which left holes in cut-off peaks). The row below
// y = 0 comes from the terrain function, as the frozen world samples it, so a block at y = 0
// has a face below it only where the terrain there is air.
// Then it meshes, reading the flags and, for each block with a face, its stored type for
// the colour. The copy and the meshing are one function on purpose, like the frozen `mesh`:
// the compiler's inlining budget is per root function, and splitting hot code into many
// small functions called from one root ran it out and cost 26-70% (Task 4). `Builder.face`
// isn't inlined (258 nodes, the limit is 256), as in the viewer.
pub pure mesh_chunk(w: World, slot: int, layer: int) -> MeshData {
    let cx = w.columns.items[slot].cx
    let cz = w.columns.items[slot].cz
    // The slots of the 3 x 3 columns around this one, west to east, then north to south.
    var around = array[int](9)
    for dz from 0 to 3 {
        for dx from 0 to 3 {
            around[dz * 3 + dx] = w.slot_at(cx + dx - 1, cz + dz - 1)
        }
    }
    var solid = array[u8](PAD * PAD * PAD)
    for py from 0 to PAD {
        let wy = layer * SIZE + py - 1
        for pz from 0 to PAD {
            let at = (py * PAD + pz) * PAD
            if wy >= HEIGHT {
                // Above the world: air, which `solid` already is.
                continue
            } else if wy < 0 {
                for px from 0 to PAD {
                    if solid_at(cx * SIZE + px - 1, wy, cz * SIZE + pz - 1, w.seed) {
                        solid[at + px] = 1
                    }
                }
            } else {
                // The row of columns this z is in (0 north, 1 this one, 2 south) and the
                // row's first stored block.
                let row = if pz == 0 { 0 } else if pz == PAD - 1 { 2 } else { 1 }
                let k = (wy * SIZE + ((pz - 1) & 31)) * SIZE
                let west = around[row * 3]
                let middle = around[row * 3 + 1]
                let east = around[row * 3 + 2]
                solid[at] = flag(w, west, k + SIZE - 1)
                if middle < 0 {
                    for x from 0 to SIZE {
                        solid[at + 1 + x] = 1
                    }
                } else {
                    // A slot from `slot_at` is one of the pool's, which the compiler can't
                    // see through the call. Without this, a release build checks this index
                    // again inside `copy_row`'s loop and its contract fails.
                    @assume(middle < w.columns.items.len)
                    copy_row(var solid, at + 1, w.columns.items[middle].blocks, k)
                }
                solid[at + PAD - 1] = flag(w, east, k)
            }
        }
    }

    var b = Builder(data: MeshData())
    for y from 0 to SIZE {
        let wy = layer * SIZE + y
        for z from 0 to SIZE {
            for x from 0 to SIZE {
                let i = ((y + 1) * PAD + z + 1) * PAD + x + 1
                if solid[i] == 1 and exposed(solid, i) {
                    let p = vec3(x, y, z)
                    let id = w.columns.items[slot].blocks.items[(wy * SIZE + z) * SIZE + x]
                    let tint = shaded(colour(id), variation(cx * SIZE + x, wy, cz * SIZE + z))
                    if solid[i + STEP_X] == 0 {
                        b.face(solid, i + STEP_X, p + vec3(1, 0, 0), vec3(0, 0, 1), vec3(0, 1, 0), shaded(tint, SIDE_X))
                    }
                    if solid[i - STEP_X] == 0 {
                        b.face(solid, i - STEP_X, p + vec3(0, 0, 1), vec3(0, 0, -1), vec3(0, 1, 0), shaded(tint, SIDE_X))
                    }
                    if solid[i + STEP_Y] == 0 {
                        b.face(solid, i + STEP_Y, p + vec3(0, 1, 0), vec3(1, 0, 0), vec3(0, 0, 1), shaded(tint, TOP))
                    }
                    if solid[i - STEP_Y] == 0 {
                        b.face(solid, i - STEP_Y, p, vec3(0, 0, 1), vec3(1, 0, 0), shaded(tint, BOTTOM))
                    }
                    if solid[i + STEP_Z] == 0 {
                        b.face(solid, i + STEP_Z, p + vec3(1, 0, 1), vec3(-1, 0, 0), vec3(0, 1, 0), shaded(tint, SIDE_Z))
                    }
                    if solid[i - STEP_Z] == 0 {
                        b.face(solid, i - STEP_Z, p, vec3(1, 0, 0), vec3(0, 1, 0), shaded(tint, SIDE_Z))
                    }
                }
            }
        }
    }
    b.data
}
