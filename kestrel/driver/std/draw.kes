// Drawing in window pixels: origin top-left, y down. The colour is always last.
pub struct Color {
    r: float
    g: float
    b: float
    a: float = 1
}

pub let WHITE = Color(1, 1, 1)
pub let BLACK = Color(0, 0, 0)
pub let GRAY = Color(0.745098, 0.745098, 0.745098)
pub let RED = Color(1, 0, 0)
pub let GREEN = Color(0, 1, 0)
pub let BLUE = Color(0, 0, 1)
pub let YELLOW = Color(1, 1, 0)
pub let ORANGE = Color(1, 0.647059, 0)
pub let PURPLE = Color(0.627451, 0.12549, 0.941176)
pub let TRANSPARENT = Color(1, 1, 1, 0)

// A rectangle: its top-left corner and its size (Godot's Rect2).
pub struct Rect {
    pos: vec2
    size: vec2
}

// A texture on the GPU. It is freed when the value that holds it goes away.
pub struct Texture {
    id: GpuHandle
    width: int
    height: int
}

pub native clear(color: Color)
// A negative width or height reaches back from pos (in rect, rect_outline and rects).
pub native rect(pos: vec2, size: vec2, color: Color)
pub native rect_outline(pos: vec2, size: vec2, width: float, color: Color)
// One rectangle of this size at each position, in order: what a rect call for each would draw,
// but in one GPU draw call, which is much faster when there are thousands. A list[vec2] works too.
pub native rects(positions: [vec2], size: vec2, color: Color)
pub native circle(center: vec2, radius: float, color: Color)
pub native circle_outline(center: vec2, radius: float, width: float, color: Color)
pub native line(a: vec2, b: vec2, width: float, color: Color)
pub native triangle(a: vec2, b: vec2, c: vec2, color: Color)
pub native text(text: string, pos: vec2, size: float, color: Color)
pub native text_width(text: string, size: float) -> float

// Textures. A relative path means the program's folder, and the window has to be open first.
// Pixels are given row by row from the top-left. A negative size mirrors the image, and the
// tint multiplies its colours (WHITE leaves them alone).
pub native load_texture(path: string) -> Texture
pub native make_texture(width: int, height: int, pixels: [Color]) -> Texture
pub native texture(tex: Texture, pos: vec2, tint: Color)
pub native texture_rect(tex: Texture, pos: vec2, size: vec2, tint: Color)
pub native texture_region(tex: Texture, region: Rect, pos: vec2, size: vec2, tint: Color)
