// A simulated network between the two peers, inside one process. Each packet takes 6 frames
// (100 ms) plus up to 2 frames of jitter to arrive, so packets can overtake each other, and 5%
// of them are lost. Its own `Rng`, seeded with a constant, decides both, so a run is the same
// every time.
//
// Packets in flight sit in a fixed set of slots made once at the start: sending writes into a
// free slot's own storage, so the network allocates nothing as the game runs (a growing list of
// packets would keep growing the program's memory).
use { Rng from random }
use { Pad, still from game }

// Frames a packet takes, the most extra frames it may take, and the share of packets lost.
pub let DELAY = 6
pub let JITTER = 2
pub let LOSS = 0.05

// Inputs each packet carries: the sender's last 8 frames, so a lost packet's inputs come with
// the next one.
pub let SENT = 8

// Packets that can be in flight at once (two peers send one a frame, each lives at most 8
// frames), and the network's seed.
let SLOTS = 32
let NET_SEED = 20261027

// What a peer sends each frame.
pub struct Packet {
    sender: int
    // The sender's newest input is for this frame; `inputs[SENT - 1]` is that input and
    // `inputs[0]` is the one 7 frames before it.
    frame: int
    inputs: [Pad]
    // The sender's newest confirmed checksum and its frame (0 before the first).
    sum_frame: int
    sum: i64
}

pub struct Net {
    rng: Rng
    slots: list[Packet]
    // The frame each slot's packet arrives on, or -1 for a free slot.
    due: [int]
    sent: int
    lost: int

    // Sends a packet from peer `sender` at frame `now`: its inputs are those of `frame` and the 7
    // frames before it, read from `history`, a ring where frame f's input is at
    // f % history.len. Frames before the first are sent as no key held.
    pure send(var self, now: int, sender: int, frame: int, history: [Pad], sum_frame: int, sum: i64) {
        self.sent += 1
        if self.rng.randf() < LOSS {
            self.lost += 1
            return
        }
        let arrives = now + DELAY + self.rng.randi_range(0, JITTER)
        for k from 0 to SLOTS {
            if self.due[k] < 0 {
                self.due[k] = arrives
                self.slots[k].sender = sender
                self.slots[k].frame = frame
                self.slots[k].sum_frame = sum_frame
                self.slots[k].sum = sum
                for j from 0 to SENT {
                    let f = frame - SENT + 1 + j
                    self.slots[k].inputs[j] = if f >= 0 { history[f % history.len] } else { still() }
                }
                return
            }
        }
        // Every slot is busy: the packet is lost like any other.
        self.lost += 1
    }

    // The packets that arrive at frame `now`, taken out of their slots. The list is new, so call
    // this inside an `arena { }` that ends before the next frame.
    pure deliver(var self, now: int) -> list[Packet] {
        var out: list[Packet] = []
        for k from 0 to SLOTS {
            if self.due[k] == now {
                out.add(self.slots[k])
                self.due[k] = -1
            }
        }
        out
    }
}

// A network with every slot free.
pub pure new_net() -> Net {
    var slots: list[Packet] = []
    var due = array[int](SLOTS)
    for k from 0 to SLOTS {
        slots.add(Packet(sender: 0, frame: 0, inputs: array[Pad](SENT), sum_frame: 0, sum: 0))
        due[k] = -1
    }
    Net(rng: Rng(seed: NET_SEED), slots: slots, due: due, sent: 0, lost: 0)
}
