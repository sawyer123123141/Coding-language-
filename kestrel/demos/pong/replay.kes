// An in-memory replay: the seed, both players' confirmed inputs for every frame, and the
// confirmed state's checksum every 60 frames. Running the inputs again from a new game made from
// the seed must give the same checksums, since `step` is deterministic. A replay file would hold
// the same three things (saving it is for a later round).
use { Game, Inputs, new_game, step from game }

// Frames between the replay's checksums.
pub let REPLAY_SUM_EVERY = 60

pub struct Replay {
    seed: int
    inputs: list[Inputs]
    sums: list[i64]

    // Adds the next confirmed frame's inputs. `after` is the state once they have run, whose
    // checksum is kept every REPLAY_SUM_EVERY frames. The lists grow by 4 bytes a frame and
    // 8 bytes a second, in the program's memory: call this outside any `arena { }`.
    pure record(var self, i: Inputs, after: Game) {
        self.inputs.add(i)
        if self.inputs.len % REPLAY_SUM_EVERY == 0 {
            self.sums.add(checksum(after))
        }
    }

    // Runs the inputs again from the start and gives the first frame whose checksum differs from
    // the one recorded, or -1 when every one matches.
    pure check(self) -> int {
        var g = new_game(self.seed)
        for f, i in self.inputs {
            step(var g, i)
            let n = f + 1
            if n % REPLAY_SUM_EVERY == 0 and checksum(g) != self.sums[n / REPLAY_SUM_EVERY - 1] {
                return n
            }
        }
        -1
    }
}

// An empty replay of a game made from `seed`.
pub pure new_replay(seed: int) -> Replay {
    Replay(seed: seed, inputs: [], sums: [])
}
