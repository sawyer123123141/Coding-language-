// A peer: one player's copy of the game, as one machine in a networked match would keep it.
//
// A peer runs the game at once with its own input and a guess for the other player's (the last
// input it received), so its own paddle never waits for the network. When the other player's
// real input for a frame arrives and the guess was wrong, it rolls back: it goes back to its
// snapshot of that frame and runs the frames again up to the present, now with what it knows.
//
// A frame is confirmed when both players' inputs for every frame before it are known; its state
// is then final, on both peers. Every 30 confirmed frames each peer records the state's
// checksum and sends it in its packets, and the two compare: a difference means the game is
// not deterministic (or `DESYNC_AT` nudged it), and the run stops.
//
// Every ring here is made once at the start, so a running peer allocates nothing.
use { Game, Pad, Inputs, new_game, step, still, same from game }
use { Packet from net }

// Snapshots kept (frames back a rollback can go), frames of inputs kept, the most frames a
// peer runs ahead of the other's newest known input before it waits, and the frames between
// checksums.
pub let RING = 16
pub let HIST = 64
pub let MAX_AHEAD = 12
pub let SUM_EVERY = 30

// Checksums kept for comparing, ours and theirs.
let SUMS = 8

// A frame at which peer 2 nudges its confirmed state, to show the checksums catch a desync.
// -1 is never.
let DESYNC_AT = -1

// No wrong guess waiting.
let NONE = 2147483647

pub struct Peer {
    // 1 plays the left paddle, 2 the right one.
    id: int
    // The present: the state at the start of frame `now` (frames 0 to now - 1 have run).
    game: Game
    now: int
    // ring[f % RING] is the state at the start of frame f, for the last RING frames.
    ring: [Game]
    // Our input for frame f is local[f % HIST].
    local: [Pad]
    // The other player's input for frame f is remote[f % HIST] when remote_at[f % HIST] == f.
    remote: [Pad]
    remote_at: [int]
    // What we guessed for the other player's frame f, while it wasn't known.
    guess: [Pad]
    // The other player's inputs are known for every frame before `known`.
    known: int
    // The newest input received, and its frame (-1 before the first): the guess for the rest.
    last: Pad
    last_at: int
    // The first frame whose guess turned out wrong, or NONE.
    wrong: int
    // Every frame up to `checked` has had its confirmed state looked at.
    checked: int
    // The newest checksum we recorded, and its frame (0 before the first).
    sum_frame: int
    sum: i64
    // Our recorded checksums and theirs, each at (frame / SUM_EVERY) % SUMS with its frame.
    mine: [i64]
    mine_at: [int]
    theirs: [i64]
    theirs_at: [int]
    // Every checksum up to this frame has matched.
    compared: int
    rollbacks: int
    deepest: int

    // Keeps the present state as frame f's snapshot. `Game` holds no list, map or string, so
    // this is a plain copy that never allocates.
    @prove(no_alloc)
    pure save(var self, f: int) {
        self.ring[f % RING] = self.game
    }

    // Goes back to frame f's snapshot.
    @prove(no_alloc)
    pure restore(var self, f: int) {
        self.game = self.ring[f % RING]
        self.now = f
    }

    // Takes in a packet from the other peer: its inputs for frames not known yet, noting a
    // wrong guess, and its newest checksum.
    pure receive(var self, pk: Packet) {
        for j from 0 to pk.inputs.len {
            let f = pk.frame - pk.inputs.len + 1 + j
            // Frames already known (or before the first) and frames too far ahead are skipped.
            if f >= self.known and f < self.known + HIST and self.remote_at[f % HIST] != f {
                let k = f % HIST
                let pad = pk.inputs[j]
                self.remote[k] = pad
                self.remote_at[k] = f
                if f > self.last_at {
                    self.last = pad
                    self.last_at = f
                }
                // A frame already run on a guess, and the guess was wrong.
                if f < self.now and not same(self.guess[k], pad) {
                    self.wrong = min(self.wrong, f)
                }
            }
        }
        while self.remote_at[self.known % HIST] == self.known {
            self.known += 1
        }
        if pk.sum_frame > 0 {
            let k = (pk.sum_frame / SUM_EVERY) % SUMS
            self.theirs[k] = pk.sum
            self.theirs_at[k] = pk.sum_frame
        }
    }

    // The other player's input for frame f: the real one when it is known, else the guess,
    // which is the newest input received (no key held before the first).
    pure predict(var self, f: int) -> Pad {
        let k = f % HIST
        if self.remote_at[k] == f {
            return self.remote[k]
        }
        let pad = if self.last_at >= 0 { self.last } else { still() }
        self.guess[k] = pad
        pad
    }

    // Both players' inputs for frame f, as this peer knows them.
    pure inputs(var self, f: int) -> Inputs {
        let mine = self.local[f % HIST]
        let theirs = self.predict(f)
        if self.id == 1 { Inputs(p1: mine, p2: theirs) } else { Inputs(p1: theirs, p2: mine) }
    }

    // Runs one frame from the present, keeping its snapshot first.
    pure run_frame(var self) {
        self.save(self.now)
        let i = self.inputs(self.now)
        step(var self.game, i)
        self.now += 1
    }

    // Goes back to frame f and runs the frames again up to the present.
    pure run_again(var self, f: int) {
        let present = self.now
        self.restore(f)
        while self.now < present {
            self.run_frame()
        }
    }

    // Rolls back to the first frame whose guess was wrong, if one was.
    pure rollback(var self) {
        if self.wrong < self.now {
            self.deepest = max(self.deepest, self.now - self.wrong)
            self.rollbacks += 1
            self.run_again(self.wrong)
        }
        self.wrong = NONE
    }

    // Runs the present frame with our input `pad`, unless we are too far ahead of the other
    // player's known inputs: then we wait a frame, and the input is dropped.
    pure advance(var self, pad: Pad) {
        if self.now - self.known >= MAX_AHEAD {
            return
        }
        self.local[self.now % HIST] = pad
        self.run_frame()
    }

    // The newest confirmed frame: both inputs are known for every frame before it, and it has run.
    pure confirmed(self) -> int {
        min(self.known, self.now)
    }

    // The state at the start of frame f, for a frame from the last RING up to the present.
    pure state_at(self, f: int) -> Game {
        if f == self.now { self.game } else { self.ring[f % RING] }
    }

    // Both players' real inputs for a confirmed frame f.
    pure inputs_at(self, f: int) -> Inputs {
        let mine = self.local[f % HIST]
        let theirs = self.remote[f % HIST]
        if self.id == 1 { Inputs(p1: mine, p2: theirs) } else { Inputs(p1: theirs, p2: mine) }
    }

    // Looks at each newly confirmed frame: records the checksum every SUM_EVERY frames, and on
    // peer 2 nudges the state at DESYNC_AT. The nudge goes into the confirmed snapshot after its
    // checksum is recorded, and the frames since are run again from it, so no rollback can undo
    // it and the next checksum shows it.
    pure confirm(var self) {
        let c = self.confirmed()
        while self.checked < c {
            self.checked += 1
            let f = self.checked
            if f % SUM_EVERY == 0 {
                self.record(f)
            }
            if f == DESYNC_AT and self.id == 2 {
                if f == self.now {
                    self.game.ball.x += 0.001
                } else {
                    self.ring[f % RING].ball.x += 0.001
                    self.run_again(f)
                }
            }
        }
    }

    // Records the checksum of confirmed frame f's state.
    pure record(var self, f: int) {
        let s = checksum(self.state_at(f))
        let k = (f / SUM_EVERY) % SUMS
        self.mine[k] = s
        self.mine_at[k] = f
        self.sum = s
        self.sum_frame = f
    }

    // Compares every checksum both peers have recorded since the last comparison, in order.
    // Gives the first frame where they differ, or -1.
    pure compare(var self) -> int {
        for n from 0 to SUMS {
            let f = self.compared + SUM_EVERY
            let k = (f / SUM_EVERY) % SUMS
            if self.mine_at[k] != f or self.theirs_at[k] != f {
                return -1
            }
            if self.mine[k] != self.theirs[k] {
                return f
            }
            self.compared = f
        }
        -1
    }
}

// Peer `id` at the start of a game made from `seed`.
pub pure new_peer(id: int, seed: int) -> Peer {
    let g = new_game(seed)
    var ring = array[Game](RING)
    for k from 0 to RING {
        ring[k] = g
    }
    var remote_at = array[int](HIST)
    for k from 0 to HIST {
        remote_at[k] = -1
    }
    Peer(id: id, game: g, now: 0, ring: ring, local: array[Pad](HIST), remote: array[Pad](HIST), remote_at: remote_at,
        guess: array[Pad](HIST), known: 0, last: still(), last_at: -1, wrong: NONE, checked: 0, sum_frame: 0, sum: 0,
        mine: array[i64](SUMS), mine_at: array[int](SUMS), theirs: array[i64](SUMS), theirs_at: array[int](SUMS),
        compared: 0, rollbacks: 0, deepest: 0)
}
